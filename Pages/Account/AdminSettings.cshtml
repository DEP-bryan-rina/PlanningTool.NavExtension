@page
@model PlanningTool.NavExtension.Pages.Account.AdminSettingsModel
@{
	ViewData["Title"] = "Admin Settings";
}
<div class="accordion" id="emailNotificationAccordion">

	<div class="accordion-item">
		<h2 class="accordion-header" id="headingEmailNotification">
			<button class="accordion-button py-2 px-3 small btn-sm"
					type="button"
					data-bs-toggle="collapse"
					data-bs-target="#collapseEmailNotification"
					aria-expanded="true"
					aria-controls="collapseEmailNotification">
				Email Notification Setting
			</button>
		</h2>

		<div id="collapseEmailNotification"
			 class="accordion-collapse collapse show"
			 aria-labelledby="headingEmailNotification"
			 data-bs-parent="#emailNotificationAccordion">

			<div class="accordion-body">

				<div class="row">

					<!-- Left Side: Form -->
					<div class="col-md-3">
						<div class="card p-3">

							<form method="post" asp-page-handler="Save">

								<input type="hidden"
									   asp-for="EmailNotification._PK_ptEmailNotification_ID" />

								<!-- Email -->
								<div class="card border-0 shadow-sm mb-3">
									<div class="card-body">

										<h6 class="fw-bold mb-3">Email Information</h6>

										<div class="mb-3">
											<label asp-for="EmailNotification._ptEmailAddress" class="form-label">
												Email Address <span class="text-danger">*</span>
											</label>

											<input asp-for="EmailNotification._ptEmailAddress"
												   type="email"
												   class="form-control erp-input"
												   required />
										</div>

										<div class="mb-0">
											<label asp-for="EmailNotification._ptUserType" class="form-label">
												User Type <span class="text-danger">*</span>
											</label>

											<select asp-for="EmailNotification._ptUserType"
													asp-items="Model.UserTypes"
													class="form-select erp-dropdown"
													required>
												<option value="">-- Select User Type --</option>
											</select>
										</div>

									</div>
								</div>

								<!-- Modules -->
								<div class="card border-0 shadow-sm mb-3">
									<div class="card-body">

										<h6 class="fw-bold mb-3">Modules</h6>

										<div class="form-check mb-2">
											<input asp-for="EmailNotification._ptImPex"
												   class="form-check-input" />
											<label asp-for="EmailNotification._ptImPex"
												   class="form-check-label">
												ImPex
											</label>
										</div>

										<div class="form-check">
											<input asp-for="EmailNotification._ptProcurement"
												   class="form-check-input" />
											<label asp-for="EmailNotification._ptProcurement"
												   class="form-check-label">
												Procurement
											</label>
										</div>

									</div>
								</div>

								<!-- Reminder Settings -->
								<div class="card border-0 shadow-sm mb-4">
									<div class="card-body">

										<h6 class="fw-bold mb-3">Reminder Settings</h6>

										<div class="row g-3 align-items-center mb-3">

											<div class="col-md-4">
												<div class="form-check">
													<input asp-for="EmailNotification._pt2WeeksReminder"
														   class="form-check-input" />
													<label asp-for="EmailNotification._pt2WeeksReminder"
														   class="form-check-label">
														Enable 2-Week Reminder
													</label>
												</div>
											</div>

											<div class="col-md-8">
												<select asp-for="EmailNotification._pt2WeeksTrigger"
														class="form-select erp-dropdown" required>
													<option value="">-- Select Trigger --</option>
													<option value="Monday">Monday</option>
													<option value="Tuesday">Tuesday</option>
													<option value="Wednesday">Wednesday</option>
													<option value="Thursday">Thursday</option>
													<option value="Friday">Friday</option>
													<option value="Saturday">Saturday</option>
													<option value="Sunday">Sunday</option>
													<option value="Daily">Daily</option>
													<option value="Weekly">Weekly</option>
													<option value="Monthly">Monthly</option>
													<option value="Yearly">Yearly</option>
												</select>
											</div>

										</div>

										<div class="row g-3 align-items-center">

											<div class="col-md-4">
												<div class="form-check">
													<input asp-for="EmailNotification._ptDelaysReminder"
														   class="form-check-input" />
													<label asp-for="EmailNotification._ptDelaysReminder"
														   class="form-check-label">
														Enable Delays Reminder
													</label>
												</div>
											</div>

											<div class="col-md-8">
												<select asp-for="EmailNotification._ptDelaysTrigger"
														class="form-select erp-dropdown" required>
													<option value="">-- Select Trigger --</option>
													<option value="Monday">Monday</option>
													<option value="Tuesday">Tuesday</option>
													<option value="Wednesday">Wednesday</option>
													<option value="Thursday">Thursday</option>
													<option value="Friday">Friday</option>
													<option value="Saturday">Saturday</option>
													<option value="Sunday">Sunday</option>
													<option value="Daily">Daily</option>
													<option value="Weekly">Weekly</option>
													<option value="Monthly">Monthly</option>
													<option value="Yearly">Yearly</option>
												</select>
											</div>

										</div>

									</div>
								</div>

								<!-- Actions -->
								<div class="d-flex gap-2">

									@if (Model.EmailNotification._PK_ptEmailNotification_ID == 0)
									{
										<button type="submit" class="btn btn-primary erp-btn px-4">
											<i class="fas fa-plus me-1"></i> Add New
										</button>
									}
									else
									{
										<button type="submit" class="btn btn-success erp-btn px-4">
											<i class="fas fa-save me-1"></i> Update
										</button>

										<a asp-page="./AdminSettings"
										   class="btn btn-outline-secondary erp-btn px-4">
											<i class="fas fa-times me-1"></i> Cancel
										</a>
									}

								</div>

							</form>

						</div>
					</div>

					<!-- Right Side: Table -->
					<div class="col-md-9">
						<table id="tblEmailNotifications" class="table table-bordered table-hover w-100">
							<thead class="sticky-top bg-white table-bordered" style="font-size:0.75rem;">
								<tr>
									<th>Email Address</th>
									<th>ImPex Notification</th>
									<th>Procurement Notification</th>
									<th>2 Weeks Reminder</th>
									<th>2 Weeks Triggered</th>
									<th>Delays Reminder</th>
									<th>Delays Triggered</th>
									<th>User Type</th>
									<th width="140" class="text-center">Action</th>
								</tr>
							</thead>

							<tbody style="font-size:0.75rem;">
								@foreach (var item in Model.NotificationList)
								{
									<tr>
										<td>@item._ptEmailAddress</td>
										<td>
											@if (item._ptImPex)
											{
												<span class="badge bg-success">
													<i class="bi bi-check-circle-fill"></i> Active
												</span>
											}
											else
											{
												<span class="badge bg-danger">
													<i class="bi bi-x-circle-fill"></i> Inactive
												</span>
											}
										</td>

										<td>
											@if (item._ptProcurement)
											{
												<span class="badge bg-success">
													<i class="bi bi-check-circle-fill"></i> Active
												</span>
											}
											else
											{
												<span class="badge bg-danger">
													<i class="bi bi-x-circle-fill"></i> Inactive
												</span>
											}
										</td>

										<td>
											@if (item._pt2WeeksReminder)
											{
												<span class="badge bg-success">
													<i class="bi bi-check-circle-fill"></i> Active
												</span>
											}
											else
											{
												<span class="badge bg-danger">
													<i class="bi bi-x-circle-fill"></i> Inactive
												</span>
											}
										</td>
										<td>
											@item._pt2WeeksTrigger
										</td>

										<td>
											@if (item._ptDelaysReminder)
											{
												<span class="badge bg-success">
													<i class="bi bi-check-circle-fill"></i> Active
												</span>
											}
											else
											{
												<span class="badge bg-danger">
													<i class="bi bi-x-circle-fill"></i> Inactive
												</span>
											}
										</td>
										<td>
											@item._ptDelaysTrigger
										</td>
										<td>
											@item._ptUserType
										</td>

										<td class="text-center">
											<a asp-page="./AdminSettings"
											   asp-route-id="@item._PK_ptEmailNotification_ID"
											   class="btn btn-warning btn-sm erp-btn">
												<i class="fa fa-pencil small text-primary"></i>
											</a>

											@if (item._ptStatus == "Inactive")
											{
												<form method="post" asp-page-handler="Activate" style="display:inline;">
													@Html.AntiForgeryToken()

													<input type="hidden"
														   name="id"
														   value="@item._PK_ptEmailNotification_ID" />

													<button type="submit"
															class="btn btn-success btn-sm erp-btn"
															title="Activate"
															onclick="return confirm('Are you sure you want to activate @item._ptEmailAddress?');">
														<i class="fa fa-check text-success"></i>
													</button>
												</form>
											}
											else
											{
												<form method="post" asp-page-handler="Delete" style="display:inline;">
													@Html.AntiForgeryToken()

													<input type="hidden"
														   name="id"
														   value="@item._PK_ptEmailNotification_ID" />

													<button type="submit"
															class="btn btn-danger btn-sm erp-btn"
															title="Inactive"
															onclick="return confirm('Are you sure you want to mark @item._ptEmailAddress as inactive?');">
														<i class="fa fa-ban text-danger"></i>
													</button>
												</form>
											}
										</td>
									</tr>
								}
							</tbody>

						</table>

                        
					</div>

				</div>

			</div>
		</div>
	</div>

</div>
<div class="card shadow-sm mt-4">
	<div class="card-header bg-light">
		<h5 class="mb-0">
			<i class="fa fa-bell me-2"></i>
			Procurement Reminders
		</h5>
	</div>

	<div class="card-body">

		@if (!Model.ReminderNotifications.Any())
		{
			<div class="alert alert-info">
				No reminders found.
			</div>
		}
		else
		{
			<div class="table-responsive" style="max-height:600px; overflow:auto;">
				<table class="table table-bordered table-striped table-hover">
					<thead class="sticky-top bg-white table-bordered table-dark" style="font-size:0.75rem;">
						<tr>
							<th>PO No</th>
							<th>HBL No</th>
							<th>Container No</th>
							<th>Vendor</th>
							<th>Description</th>
							<th>Country</th>
							<th>ETA</th>
							<th class="text-center">Days</th>
							<th>Status</th>
							<th class="text-end">Delivered Qty</th>
						</tr>
					</thead>
					<tbody style="font-size:0.75rem;">
						@foreach (var item in Model.ContainerETAView)
						{
							var badge = "bg-secondary";
							var text = "";

							if (item.ShipmentStatus == "Due")
							{
								badge = "bg-warning text-dark";
								text = $"Due ({item.DaysToETA} Days)";
							}
							else if (item.ShipmentStatus == "Delayed")
							{
								badge = "bg-danger";
								text = $"Delayed {Math.Abs(item.DaysToETA)} Days";
							}

							<tr>

								<td>@item._ptDocNo</td>

								<td>@item._ptHBLNo</td>

								<td>@item._ptContainerNo</td>

								<td>@item._ptVendorName</td>

								<td>@item._ptItemDescription</td>

								<td>@item._ptCountryOfOrigin</td>

								<td>
									@item._ptContainerETA?.ToString("yyyy-MM-dd")
								</td>

								<td class="text-center">
									@item.DaysToETA
								</td>

								<td>
									<span class="badge @badge">
										@text
									</span>
								</td>

								<td class="text-end">
									@(Convert.ToDecimal(item._ptPartialDelivered).ToString("N2"))
								</td>

							</tr>
						}
					</tbody>
				</table>

			</div>
		}

	</div>
</div>
@section Scripts
{
	<style>
		.dataTables_filter input {
			width: 300px !important;
		}

		div.dataTables_scrollBody {
			max-height: 25vh !important;
		}
	</style>

	<script>
		$(document).ready(function () {

			$('#tblEmailNotifications').DataTable({
				pageLength: 25,
				scrollX: true,
				scrollY: '60vh',
				scrollCollapse: true,
				paging: true,
				autoWidth: false,
				fixedHeader: true,
				stateSave: false
			});

		});

	</script>
}