@page
@model PlanningTool.NavExtension.Pages.Expiration.IndexModel
@{
	ViewData["Title"] = "Expiration Page";
}
<div class="container-fluid">

	<div class="d-flex justify-content-between align-items-center mb-3">

		<ul class="nav nav-tabs" id="expirationTab" role="tablist">

			<li class="nav-item">
				<button class="nav-link active"
						data-bs-toggle="tab"
						data-bs-target="#wms">
					WMS - Custom Expiration
				</button>
			</li>

			<li class="nav-item">
				<button class="nav-link"
						data-bs-toggle="tab"
						data-bs-target="#qa">
					Reject - Custom Expiration
				</button>
			</li>

		</ul>

		<a asp-page-handler="ExportExcel"
		   class="btn btn-success">
			<i class="bi bi-file-earmark-excel-fill me-1"></i>
			Export to Excel
		</a>

	</div>
	<div class="tab-content mt-3">

		<!-- WMS -->
		<div class="tab-pane fade show active" id="wms">

			<table id="tblWMS" class="table table-hover w-100">

				<thead class="sticky-top bg-white table-bordered" style="font-size:0.75rem;">

					<tr>
						<th>Item No.</th>
						<th>Description</th>
						<th>Lot No.</th>
						<th>Quantity</th>
						<th>Expiration Date</th>
						<th>Days Remaining</th>
					</tr>
				</thead>

				<tbody>

					@foreach (var item in Model.WMSList)
					{
						<tr>

							<td>@item.ItemNo</td>
							<td>@item.Description</td>
							<td>@item.LotNo</td>
							<td>@item.Quantity.ToString("N2")</td>
							<td>@item.ExpirationDate.ToString("MMM dd, yyyy")</td>

							<td>
								@if (item.DaysRemaining <= 30)
								{
									<span class="badge bg-danger">
										@item.DaysRemaining Days
									</span>
								}
								else if (item.DaysRemaining <= 90)
								{
									<span class="badge bg-warning text-dark">
										@item.DaysRemaining Days
									</span>
								}
								else
								{
									<span class="badge bg-success">
										@item.DaysRemaining Days
									</span>
								}
							</td>

						</tr>
					}

				</tbody>

			</table>

		</div>

	</div>

	<!-- QA -->

	<div class="tab-pane fade" id="qa">

		<table id="tblQA" class="table table-hover w-100 ">

			<thead class="sticky-top bg-white table-bordered" style="font-size:0.75rem;">

					
				<tr>
					<th>Item No.</th>
					<th>Description</th>
					<th>Lot No.</th>
					<th>Quantity</th>
					<th>Expiration Date</th>
					<th>Days Remaining</th>
				</tr>
			</thead>

			<tbody>

				@foreach (var item in Model.QAList)
				{
					<tr>

						<td>@item.ItemNo</td>
						<td>@item.Description</td>
						<td>@item.LotNo</td>
						<td>@item.Quantity.ToString("N2")</td>
						<td>@item.ExpirationDate.ToString("MMM dd, yyyy")</td>

						<td>
							@if (item.DaysRemaining <= 30)
							{
								<span class="badge bg-danger">
									@item.DaysRemaining Days
								</span>
							}
							else if (item.DaysRemaining <= 90)
							{
								<span class="badge bg-warning text-dark">
									@item.DaysRemaining Days
								</span>
							}
							else
							{
								<span class="badge bg-success">
									@item.DaysRemaining Days
								</span>
							}
						</td>

					</tr>
				}

			</tbody>

		</table>

	</div>

</div>
@section Scripts {
	<script>
		$(function () {	            
			const table = $('#tblWMS').DataTable({
					pageLength: 25,
					scrollX: true,
					scrollY: '60vh',
					scrollCollapse: true,
					paging: true,
					autoWidth: false,
					fixedHeader: true
				});
				$('.dataTables_filter input').css({
					'width': '300px',
					'min-width': '300px'
				});
				const savedSearch = sessionStorage.getItem('ttblWMSSearch');

				if (savedSearch) {
					table.search(savedSearch).draw();
					$('.dataTables_filter input').val(savedSearch);
				}

				$('.dataTables_filter input').on('keyup', function () {
					sessionStorage.setItem('tblWMSSearch', this.value);
			});

		});
		$(function () {
			const table = $('#tblQA').DataTable({
					pageLength: 25,
					scrollX: true,
					scrollY: '60vh',
					scrollCollapse: true,
					paging: true,
					autoWidth: false,
					fixedHeader: true
				});
				$('.dataTables_filter input').css({
					'width': '300px',
					'min-width': '300px'
				});
				const savedSearch = sessionStorage.getItem('tblQASearch');

				if (savedSearch) {
					table.search(savedSearch).draw();
					$('.dataTables_filter input').val(savedSearch);
				}

				$('.dataTables_filter input').on('keyup', function () {
					sessionStorage.setItem('tblQASearch', this.value);
			});

		});
	</script>	
}

		


