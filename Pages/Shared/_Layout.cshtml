@using System.Linq
@using Microsoft.EntityFrameworkCore
@using PlanningTool.NavExtension.Data
@using PlanningTool.NavExtension.Models
@using PlanningTool.NavExtension.Services

@inject IUserPermissionService PermissionService
@inject AppDbContext _context

@{
	var currentPath = Context.Request.Path.Value ?? "";
	var currentUser = User?.Identity?.Name ?? "Contact IT Team";

	var permission = string.IsNullOrWhiteSpace(currentUser)
		? null
		: await PermissionService.GetUserPermissionAsync(currentUser.ToUpperInvariant());


	var today = DateTime.Today;
	var tomorrow = today.AddDays(1);

	var todayImpex = await _context.GetImPexItems
		.Where(x => x._ptCreatedDate >= today &&
					x._ptCreatedDate < tomorrow)
		.ToListAsync();

	var impexCreatedToday = todayImpex.Count;

	
	var todayShipments = await _context.GetTaggedItems
	.Where(x =>
		x._ptContainerETA >= today &&
		x._ptContainerETA < tomorrow &&
		x._ptStatus == 1)
	.ToListAsync();

	var upcomingCount = todayShipments.Count;
}
<style>
	@@keyframes sail {
		0%, 100% {
			transform: translateX(0);
		}

		50% {
			transform: translateX(5px);
		}
	}
</style>
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] | Planning Tool - NAV Extension</title>
	<link rel="icon" type="image/x-icon" href="~/logo.ico" />

	<!-- Bootstrap -->
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

	<!-- Icons -->
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

	<!-- Select2 -->
	<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/css/select2.min.css" rel="stylesheet">

	<!-- DataTables -->
	<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css">
	<link rel="stylesheet" href="https://cdn.datatables.net/fixedheader/3.4.1/css/fixedHeader.bootstrap5.min.css">
	<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css">

	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

	<!-- jQuery -->
	<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

	<!-- Bootstrap JS -->
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

	<!-- Select2 -->
	<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/js/select2.min.js"></script>

		
	<!-- DataTables -->
	<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
	<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

	<!-- FixedHeader -->
	<script src="https://cdn.datatables.net/fixedheader/3.4.1/js/dataTables.fixedHeader.min.js"></script>

	<!-- Buttons -->
	<script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
	<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>

	<!-- JSZip -->
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

	<!-- Excel Export -->
	<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

	<!-- Print -->
	<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

	<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>


</head>

<body class="d-flex flex-column min-vh-100" style="overflow-x:hidden">
	<!-- Global Loader -->

	<div id="globalLoader" class="loader-overlay">
		<div class="loader-container">

			<div class="loader-title">
				@* Planning Management System *@
			</div>

			<img src="~/logo.png" alt="logo" class="loader-logo" />

			<div class="loader-text">
				Synchronizing NAV Data...
			</div>

			<div class="loader-subtext">
				Please wait while the latest planning information is being updated.
			</div>

		</div>
	</div>

	<!-- ✅ TOP NAVBAR ONLY -->
	<nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top" style="padding: 10px">

		<a class="navbar-brand" asp-page="/Index">
			<span class="fw-medium" style="color: darkorange">Planning Tool</span>
			<small class="opacity-75">| NAV Extension</small>
		</a>

		<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topMenu">
			<span class="navbar-toggler-icon"></span>
		</button>

		<div class="collapse navbar-collapse" id="topMenu">
			@{
				var menus = new[]
				{
					new
					{
						Visible = permission?.ImPex == true,
						Path = "/ImPex",
						Page = "/ImPex/Index",
						Icon = "bi-globe2",
						Text = "ImPex Center"
					},
					new
					{
						Visible = permission?.Procurement == true,
						Path = "/Procurement",
						Page = "/Procurement/Index",
						Icon = "bi-file-earmark-text-fill",
						Text = "Procurement Center"
					}
				};

				var visibleMenus = menus.Where(m => m.Visible).ToList();
			}

			<ul class="navbar-nav me-auto">

				@if (visibleMenus.Any())
				{
					<li class="nav-item dropdown">
						<a class="nav-link dropdown-toggle"
						   href="#"
						   id="arrivalUpdateMenu"
						   role="button"
						   data-bs-toggle="dropdown"
						   aria-expanded="false">
							Material Arrival Update
						</a>

						<ul class="dropdown-menu" aria-labelledby="arrivalUpdateMenu">
							@foreach (var menu in visibleMenus)
							{
								<li>
									<a class="dropdown-item @(currentPath.StartsWith(menu.Path) ? "active" : "")"
									   asp-page="@menu.Page">
										<i class="bi @menu.Icon me-2"></i>
										@menu.Text
									</a>
								</li>
							}
						</ul>
					</li>
				}

				<li class="nav-item">
					<a class="nav-link @(currentPath.StartsWith("/WHS") ? "active" : "")"
					   asp-page="/WHS/Index">
						<i class="bi bi-box-seam me-1"></i>
						WHS
					</a>
				</li>

			</ul>
			@* Shipments Today Notification *@
			<div class="position-relative shipment-notification me-3">
				@{
					var shipmentDetails = todayShipments
						.Select(x => new
						{
							HBL = x._ptHBLNo,
							Container = x._ptContainerNo,
							Origin = x._ptCountryOfOrigin
						})
						.ToList();
				}
				<button class="btn btn-link text-white p-0 position-relative"
						type="button"
						onclick="window.location.href='/WHS/Index'">

					<i class="fas fa-ship" style="display:inline-block; animation:pulse 2s ease-in-out infinite;"></i>

					@if (upcomingCount > 0)
					{
						<span class="shipment-badge">
							@upcomingCount
						</span>
					}
				</button>

				<div class="shipment-tooltip">

					<div class="shipment-header">
						<i class="fas fa-ship"></i>
						<span>Today's Shipments</span>
					</div>

					@foreach (var shipment in todayShipments)
					{
						<div class="shipment-row">

							<div class="shipment-hbl">
								<i class="fas fa-file-invoice me-1"></i>
								HBL No. : @shipment._ptHBLNo
							</div>

							<div class="shipment-info">

								<span>
									<i class="fas fa-file-alt"></i>
									@shipment._ptDocNo
								</span>

								<span>
									<i class="fas fa-barcode"></i>
									@shipment._ptItemCode
								</span>

								<span>
									<i class="fas fa-box-open"></i>
									@shipment._ptItemDescription
								</span>

								<span>
									<i class="fas fa-truck-loading"></i>
									Tagged Qty: @shipment._ptPartialDelivered
								</span>

							</div>

						</div>
					}

					@if (upcomingCount == 0)
					{
						<div class="shipment-empty">
							No shipments today
						</div>
					}

				</div>
			</div>

			@* HBL Notification *@
			<div class="position-relative me-3 impex-notification">
				@{
					var hblNumbers = string.Join(", ",
						todayImpex
							.Where(x => !string.IsNullOrWhiteSpace(x._ptHBLNo))
							.Select(x => x._ptHBLNo));
				}

				<button class="btn btn-link text-white p-0 position-relative"
						type="button">

					<i class="fas fa-bell"></i>

					@if (impexCreatedToday > 0)
					{
						<span class="impex-badge">
							@impexCreatedToday
						</span>
					}
				</button>

				<div class="impex-tooltip">

					<div class="impex-header">
						<i class="fas fa-bell"></i>
						<span>New HBL Created Today</span>
					</div>

					@if (todayImpex.Any())
					{
						foreach (var item in todayImpex)
						{
							<div class="impex-row">

								<div class="impex-hbl">
									@item._ptHBLNo
								</div>

								<div class="impex-info">

									<span>
										<i class="fas fa-box"></i>
										@item._ptContainerNo
									</span>

									<span>
										<i class="fas fa-calendar-alt"></i>
										@item._ptContainerETA?.ToString("yyyy-MM-dd")
									</span>

									<span>
										<i class="fas fa-globe-asia"></i>
										@item._ptCountryOfOrigin
									</span>

									<span>
										@if (string.IsNullOrWhiteSpace(item._ptRemarks))
										{
											<i class="fas fa-comment-slash text-muted"></i>
											<span class="text-muted">No Remarks</span>
										}
										else
										{
											<i class="fas fa-comment-alt"></i>
											<span>@item._ptRemarks</span>
										}
									</span>

								</div>

							</div>
						}
					}
					else
					{
						<div class="impex-empty">
							No new HBL today
						</div>
					}

				</div>

			</div>

			@* Display User *@
			<div class="d-flex align-items-center text-white">

				<button id="btnRefresh"
						class="btn btn-link text-white p-0 me-3"
						title="Sync All Data">
					<i class="fas fa-sync-alt"></i>
				</button>

				<i class="bi bi-person-circle me-1" style="color: darkorange"></i>
				<span>@currentUser</span>

			</div>

		</div>
	</nav>

	<!-- ✅ MAIN CONTENT -->
	<main style="height:auto; min-height:auto;">
		@RenderBody()
	</main>


	<!-- ✅ FOOTER CONTENT -->
	<footer class="bg-dark text-light py-2 mt-auto">
		<div class="container-fluid">
			<div class="row small">

				<div class="col-md-8 text-start">				

					<div class="col-md-4 d-flex align-items-center">
						<i class="fas fa-building me-2 text-light"></i>
						
						<span class="fw-semibold" style="color: darkorange;">DEDONPH</span>
						<span class="ms-3" id="liveDate"></span>
						<span class="ms-3">@currentUser</span>
					</div>
				</div>
				<div class="col-md-4 text-end">
					<span class="fw-semibold" style="color: darkorange;">Planning Tool</span> |	
					NAV Extension version v2026.7.1
				</div>

			</div>
		</div>
	</footer>

	<!-- ✅ TOASTS -->
	<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100">

		@if (TempData["SuccessMessage"] != null)
		{
			<div class="toast text-bg-success border-0 show-toast">
				<div class="d-flex">
					<div class="toast-body">
						<strong>Success</strong><br />
						@TempData["SuccessMessage"]
					</div>
					<button type="button" class="btn-close btn-close-white me-2 m-auto"
							data-bs-dismiss="toast"></button>
				</div>
			</div>
		}

		@if (TempData["ErrorMessage"] != null)
		{
			<div class="toast text-bg-danger border-0 show-toast">
				<div class="d-flex">
					<div class="toast-body">
						<strong>Error</strong><br />
						@TempData["ErrorMessage"]
					</div>
					<button type="button" class="btn-close btn-close-white me-2 m-auto"
							data-bs-dismiss="toast"></button>
				</div>
			</div>
		}

	</div>

	<!-- Toast script -->
	<script>
		document.addEventListener("DOMContentLoaded", function () {

		// Toast Notifications
		document.querySelectorAll(".show-toast").forEach(el => {
		new bootstrap.Toast(el, {
		delay: 3000
		}).show();
		});

		// Live Date
		function updateClock() {
		const now = new Date();

		const formatted = now.toLocaleDateString("en-US", {
		weekday: "long",
		month: "long",
		day: "numeric",
		year: "numeric"
		});

		const liveDate = document.getElementById("liveDate");

		if (liveDate) {
		liveDate.textContent = formatted;
		}
		}

		updateClock();

		// Refresh every minute (date only changes once a day)
		setInterval(updateClock, 60000);

		// Show Loader on Navigation
		document.addEventListener("click", function (e) {

		const link = e.target.closest("a");

		if (
		link &&
		link.href &&
		!link.href.includes("#") &&
		!link.href.startsWith("javascript:") &&
		link.target !== "_blank"
		) {
		const loader = document.getElementById("globalLoader");

		if (loader) {
		loader.style.display = "flex";
		loader.style.opacity = "1";
		}
		}
		});

		// Refresh Button
		$("#btnRefresh").on("click", function () {
		location.reload();
		});

		});

		// Hide Loader When Page Fully Loads
		window.addEventListener("load", function () {

		const loader = document.getElementById("globalLoader");

		if (!loader) return;

		setTimeout(() => {

		loader.style.opacity = "0";

		setTimeout(() => {
		loader.style.display = "none";
		}, 300);

		}, 200);

		});
	</script>

	@await RenderSectionAsync("Scripts", required: false)

</body>
</html>