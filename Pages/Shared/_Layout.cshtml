@using PlanningTool.NavExtension.Services
@inject IUserPermissionService PermissionService

@{
	var currentPath = Context.Request.Path.Value ?? "";
	var currentUser = User?.Identity?.Name ?? "Contact IT Arky";

	var permission = string.IsNullOrWhiteSpace(currentUser)
		? null
		: await PermissionService.GetUserPermissionAsync(currentUser.ToUpperInvariant());
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - Planning Tool - NAV Extension</title>

	<!-- Bootstrap -->
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

	<!-- Icons -->
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

	<!-- Select2 -->
	<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/css/select2.min.css" rel="stylesheet">

	<!-- DataTables -->
	<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css">
	<link rel="stylesheet" href="https://cdn.datatables.net/fixedheader/3.4.1/css/fixedHeader.bootstrap5.min.css">

	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

	<!-- jQuery -->
	<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

	<!-- Bootstrap JS -->
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

	<!-- Select2 -->
	<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/js/select2.min.js"></script>

	<!-- DataTables -->
	<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
	<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
	<script src="https://cdn.datatables.net/fixedheader/3.4.1/js/dataTables.fixedHeader.min.js"></script>

</head>

<body class="d-flex flex-column min-vh-100">
	<!-- Global Loader -->
	<div id="globalLoader" class="loader-overlay">
		<div class="loader-title">
			Planning Management System
		</div>
		<br />
		<div class="loader-text" style="margin-left: 5px">
			Synchronizing NAV Data...
		</div>
	</div>

	<!-- ✅ TOP NAVBAR ONLY -->
	<nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top" style="padding: 10px">

		<a class="navbar-brand fw-bold" asp-page="/Index">
			Planning Tool - NAV Extension
		</a>

		<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topMenu">
			<span class="navbar-toggler-icon"></span>
		</button>

		<div class="collapse navbar-collapse" id="topMenu">

			<ul class="navbar-nav me-auto">

				<!-- 🔷 Material Planning Main Menu -->
				<li class="nav-item dropdown">
					<a class="nav-link dropdown-toggle"
					   href="#"
					   id="materialPlanningMenu"
					   role="button"
					   data-bs-toggle="dropdown"
					   aria-expanded="false">
						Material Arrival Update
					</a>

					<ul class="dropdown-menu" aria-labelledby="materialPlanningMenu">

						@if (permission?.ImPex == true)
						{
							<li>
								<a class="dropdown-item @(currentPath.StartsWith("/ImPex") ? "active" : "")"
								   asp-page="/ImPex/Index">
									<i class="bi bi-globe2 me-2"></i>
									Impex Center
								</a>
							</li>
						}

						@if (permission?.Procurement == true)
						{
							<li>
								<a class="dropdown-item @(currentPath.StartsWith("/Procurement") ? "active" : "")"
								   asp-page="/Procurement/Index">
									<i class="bi bi-cart-check me-2"></i>
									Procurement Center
								</a>
							</li>

							<li>
								<a class="dropdown-item @(currentPath.StartsWith("/Expiration") ? "active" : "")"
								   asp-page="/Expiration/Index">
									<i class="bi bi-calendar-x me-2"></i>
									Expiration Monitoring Dashboard
								</a>
							</li>
						}

					</ul>
				</li>

			</ul>

			<div class="d-flex align-items-center text-white">
				<i class="bi bi-person-circle me-1"></i>
				@currentUser
			</div>

		</div>
	</nav>

	<!-- ✅ MAIN CONTENT -->
	<main class="container-fluid flex-fill py-4 mt-5">
		@RenderBody()
	</main>
	<footer class="bg-dark text-light py-2 mt-auto">
		<div class="container-fluid">
			<div class="row small">

				<div class="col-md-4 text-start">
					<i class="fas fa-industry me-1"></i>
					Planning Management System
				</div>

				<div class="col-md-4 text-center">
					<span id="liveDate"></span>
				</div>

				<div class="col-md-4 text-end">
					Version 1.0.1
				</div>

			</div>
		</div>
	</footer>

	<!-- ✅ TOASTS -->
	<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100">

		@if (TempData["SuccessMessage"] != null)
		{
			<div class="toast text-bg-success border-0 show-toast">
				<div class="d-flex">
					<div class="toast-body">
						<strong>Success</strong><br />
						@TempData["SuccessMessage"]
					</div>
					<button type="button" class="btn-close btn-close-white me-2 m-auto"
							data-bs-dismiss="toast"></button>
				</div>
			</div>
		}

		@if (TempData["ErrorMessage"] != null)
		{
			<div class="toast text-bg-danger border-0 show-toast">
				<div class="d-flex">
					<div class="toast-body">
						<strong>Error</strong><br />
						@TempData["ErrorMessage"]
					</div>
					<button type="button" class="btn-close btn-close-white me-2 m-auto"
							data-bs-dismiss="toast"></button>
				</div>
			</div>
		}

	</div>

	<!-- Toast script -->
	<script>
		document.addEventListener("DOMContentLoaded", function () {

		// Toast Notifications
		document.querySelectorAll(".show-toast").forEach(el => {
		new bootstrap.Toast(el, {
		delay: 3000
		}).show();
		});

		// Live Clock
		function updateClock() {
		const now = new Date();

		const formatted =
		now.toLocaleDateString("en-GB", {
		day: "2-digit",
		month: "short",
		year: "numeric"
		}) +
		" " +
		now.toLocaleTimeString();

		document.getElementById("liveDate")?.replaceChildren(formatted);
		}

		updateClock();
		setInterval(updateClock, 1000);

		// Show Loader on Navigation
		document.addEventListener("click", function (e) {

		const link = e.target.closest("a");

		if (
		link &&
		link.href &&
		!link.href.includes("#") &&
		!link.href.startsWith("javascript:") &&
		link.target !== "_blank"
		) {
		const loader = document.getElementById("globalLoader");

		if (loader) {
		loader.style.display = "flex";
		loader.style.opacity = "1";
		}
		}
		});
		});

		// Hide Loader When Page Fully Loads
		window.addEventListener("load", function () {

		const loader = document.getElementById("globalLoader");

		if (!loader) return;

		setTimeout(() => {
		loader.style.opacity = "0";

		setTimeout(() => {
		loader.style.display = "none";
		}, 300);

		}, 200);
		});
	</script>

	@await RenderSectionAsync("Scripts", required: false)

</body>
</html>