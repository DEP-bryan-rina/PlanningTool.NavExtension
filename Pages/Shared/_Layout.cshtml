@using PlanningTool.NavExtension.Services
@inject IUserPermissionService PermissionService

@{
	var currentPath = Context.Request.Path.Value ?? "";

	var currentUser = User?.Identity?.Name ?? "Contact IT Arky";

	var permission = string.IsNullOrWhiteSpace(currentUser)
		? null
		: await PermissionService.GetUserPermissionAsync(
			currentUser.ToUpperInvariant());
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - DEDON Planning Tool</title>

	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

	<!-- ✅ jQuery -->
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

	<!-- ✅ Select2 -->
	<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/css/select2.min.css" rel="stylesheet" />
	<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/js/select2.min.js"></script>

	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

	
	<script>
		document.addEventListener("DOMContentLoaded", function () {
			const toastElList = document.querySelectorAll('.show-toast');

			toastElList.forEach(function (toastEl) {
				const toast = new bootstrap.Toast(toastEl, {
					delay: 3000,
					autohide: true
				});
				toast.show();
			});
		});
	</script>

</head>
<body>
	<div class="app-container">
		<!-- ✅ Global Toast Container -->
		<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100">

			@if (TempData["SuccessMessage"] != null)
			{
				<div class="toast text-bg-success border-0 show-toast"
					 role="alert" data-bs-delay="3000">
					<div class="d-flex">
						<div class="toast-body">
							<strong>Success</strong><br />
							@TempData["SuccessMessage"]
						</div>
						<button type="button" class="btn-close btn-close-white me-2 m-auto"
								data-bs-dismiss="toast"></button>
					</div>
				</div>
			}
			@if (TempData["ErrorMessage"] != null)
			{
				<div class="toast text-bg-danger border-0 show-toast"
					 role="alert" data-bs-delay="3000">
					<div class="d-flex">
						<div class="toast-body">
							<strong>Error</strong><br />
							@TempData["ErrorMessage"]
						</div>
						<button type="button" class="btn-close btn-close-white me-2 m-auto"
								data-bs-dismiss="toast"></button>
					</div>
				</div>
			}

		</div>

		<nav class="side-panel" id="sidePanel" aria-label="Main navigation">
			<div class="sidebar-header">
				<span>DEDON Planning Tool</span>
			</div>

			<div class="nav-section fw-bold">Navigation</div>

			<ul class="nav-menu" role="menu">

				@if (permission.ImPex)
				{
					<li role="none">
						<a asp-page="/Impex/Index"
						   class="nav-link @(currentPath.StartsWith("/Impex") ? "active" : "")"
						   role="menuitem">
							Impex Center
						</a>
					</li>
				}

				@if (permission.Procurement)
				{
					<li role="none">
						<a asp-page="/Procurement/Index"
						   class="nav-link @(currentPath.StartsWith("/Procurement") ? "active" : "")"
						   role="menuitem">
							Procurement Center
						</a>
					</li>
				}

			</ul>
			<div class="side-footer">
				<div><strong>Version</strong> 1.0.0</div>
				<div class="small">PlanningTool.NAVExtension</div>
			</div>
		</nav>

		<div class="main-wrapper">
			<header class="topbar">
				<button id="toggleSideBtn" class="btn btn-sm btn-outline-secondary">
					☰
				</button>

				<span class="topbar-title">@ViewData["Title"]</span>

				<div class="ms-auto d-flex align-items-center gap-3">
					<div>
						<i class="bi bi-person-circle me-1"></i>
						@currentUser
					</div>
				</div>
			</header>

			<main class="content">
				<div class="nav-body">

					@RenderBody()
				</div>
			</main>

			<footer class="nav-footer">
				&copy; 2026 - DEDONPlanningTool.NAVExtension — @DateTime.Now.ToString("MMMM dd, yyyy") @(User?.Identity?.IsAuthenticated == true ? User.Identity.Name : System.Security.Principal.WindowsIdentity.GetCurrent().Name)
			</footer>
		</div>
	</div>

	@* <script src="~/lib/jquery/dist/jquery.min.js"></script> *@
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script>
		// Toggle sidebar (mobile)
		(function(){
		const btn = document.getElementById('toggleSideBtn');
		const side = document.getElementById('sidePanel');
		btn?.addEventListener('click', function(){
		const open = side.classList.toggle('open');
		btn.setAttribute('aria-expanded', open ? 'true' : 'false');
		});

		// Mark active nav item by matching href to current path
		function normalize(p){ return (p||'').replace(/\/+$/, '').toLowerCase() || '/'; }
		document.addEventListener('DOMContentLoaded', function(){
		const links = Array.from(document.querySelectorAll('.nav-menu a'));
		const current = normalize(window.location.pathname);
		let found = false;
		links.forEach(a => {
		const href = normalize(a.getAttribute('href'));
		if(href === current){
		a.classList.add('active');
		a.setAttribute('aria-current','page');
		found = true;
		} else {
		a.classList.remove('active');
		}
		// persist last clicked item
		a.addEventListener('click', () => {
		try { localStorage.setItem('navActive', a.getAttribute('href')); } catch {}
		});
		});
		// restore persisted selection if present
		try{
		const saved = localStorage.getItem('navActive');
		if(!found && saved){
		const target = links.find(l => normalize(l.getAttribute('href')) === normalize(saved));
		if(target){ target.classList.add('active'); target.setAttribute('aria-current','page'); }
		}
		}catch(e){}
		});
		})();
	</script>
	<script>
		(function () {
		const btn = document.getElementById('toggleSideBtn');
		const side = document.getElementById('sidePanel');
		const main = document.querySelector('.main-wrapper');

		// Restore state
		try {
		const collapsed = localStorage.getItem('sidebarCollapsed') === 'true';
		if (collapsed) {
		side.classList.add('collapsed');
		main.classList.add('expanded');
		}
		} catch {}

		btn?.addEventListener('click', function () {
		const isCollapsed = side.classList.toggle('collapsed');
		main.classList.toggle('expanded');

		btn.setAttribute('aria-expanded', !isCollapsed);

		// Save state
		try {
		localStorage.setItem('sidebarCollapsed', isCollapsed);
		} catch {}
		});
		})();
	</script>

	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>