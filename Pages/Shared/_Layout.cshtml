@using PlanningTool.NavExtension.Services
@inject IUserPermissionService PermissionService

@{
	var currentPath = Context.Request.Path.Value ?? "";
	var currentUser = User?.Identity?.Name ?? "Contact IT Team";

	var permission = string.IsNullOrWhiteSpace(currentUser)
		? null
		: await PermissionService.GetUserPermissionAsync(currentUser.ToUpperInvariant());
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] | Planning Tool - NAV Extension</title>
	<link rel="icon" type="image/x-icon" href="~/logo.ico" />

	<!-- Bootstrap -->
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

	<!-- Icons -->
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

	<!-- Select2 -->
	<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/css/select2.min.css" rel="stylesheet">

	<!-- DataTables -->
	<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css">
	<link rel="stylesheet" href="https://cdn.datatables.net/fixedheader/3.4.1/css/fixedHeader.bootstrap5.min.css">
	<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css">

	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

	<!-- jQuery -->
	<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

	<!-- Bootstrap JS -->
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

	<!-- Select2 -->
	<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/js/select2.min.js"></script>

		
	<!-- DataTables -->
	<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
	<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

	<!-- FixedHeader -->
	<script src="https://cdn.datatables.net/fixedheader/3.4.1/js/dataTables.fixedHeader.min.js"></script>

	<!-- Buttons -->
	<script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
	<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>

	<!-- JSZip -->
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

	<!-- Excel Export -->
	<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

	<!-- Print -->
	<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

</head>

<body class="d-flex flex-column min-vh-100" style="overflow-x:hidden">
	<!-- Global Loader -->

	<div id="globalLoader" class="loader-overlay">
		<div class="loader-container">

			<div class="loader-title">
				@* Planning Management System *@
			</div>

			<img src="~/logo.png" alt="logo" class="loader-logo" />

			<div class="loader-text">
				Synchronizing NAV Data...
			</div>

			<div class="loader-subtext">
				Please wait while the latest planning information is being updated.
			</div>

		</div>
	</div>

	<!-- ✅ TOP NAVBAR ONLY -->
	<nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top" style="padding: 10px">

		<a class="navbar-brand fw-bold" asp-page="/Index">
			Planning Tool - NAV Extension
		</a>

		<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topMenu">
			<span class="navbar-toggler-icon"></span>
		</button>

		<div class="collapse navbar-collapse" id="topMenu">

			<ul class="navbar-nav me-auto">

				<!-- 🔷 Material Planning Main Menu -->
				<li class="nav-item dropdown">
					<a class="nav-link dropdown-toggle"
					   href="#"
					   id="materialPlanningMenu"
					   role="button"
					   data-bs-toggle="dropdown"
					   aria-expanded="false">
						Material Arrival Update
					</a>

					<ul class="dropdown-menu" aria-labelledby="materialPlanningMenu">

						@{
							var menus = new[]
							{
								new
								{
									Visible = permission?.ImPex == true,
									Path = "/ImPex",
									Page = "/ImPex/Index",
									Icon = "bi-globe2",
									Text = "Impex Center"
								},
								new
								{
									Visible = permission?.Procurement == true,
									Path = "/Procurement",
									Page = "/Procurement/Index",
									Icon = "bi-cart-check",
									Text = "Procurement Center"
								}
							};
						}

						@foreach (var menu in menus.Where(m => m.Visible))
						{
							<li>
								<a class="dropdown-item @(currentPath.StartsWith(menu.Path) ? "active" : "")"
								   asp-page="@menu.Page">
									<i class="bi @menu.Icon me-2"></i>
									@menu.Text
								</a>
							</li>
						}

					</ul>
				</li>
				<li class="nav-item">
					<a class="nav-link @(currentPath.StartsWith("/WHS") ? "active" : "")"
					   asp-page="/WHS/Index">
						<i class="bi bi-box-seam me-1"></i>
						WHS
					</a>
				</li>
			</ul>

			<div class="d-flex align-items-center text-white">

				<!-- Refresh Button -->

				<button id="btnRefresh"
						class="btn btn-link text-white me-3"
						title="Sync all data">

					<i class="fas fa-sync-alt"></i>

				</button>
				<i class="bi bi-person-circle me-1"></i>
				@currentUser
			</div>

		</div>
	</nav>

	<!-- ✅ MAIN CONTENT -->
	<main class="">
		@RenderBody()
	</main>
	<footer class="bg-dark text-light py-2 mt-auto">
		<div class="container-fluid">
			<div class="row small">

				<div class="col-md-4 text-start">
					<i class="fas fa-industry me-1"></i>
					Planning Management System
				</div>

				<div class="col-md-4 text-center">
					<span id="liveDate"></span>
				</div>

				<div class="col-md-4 text-end">
					Version 1.0.1
				</div>

			</div>
		</div>
	</footer>

	<!-- ✅ TOASTS -->
	<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100">

		@if (TempData["SuccessMessage"] != null)
		{
			<div class="toast text-bg-success border-0 show-toast">
				<div class="d-flex">
					<div class="toast-body">
						<strong>Success</strong><br />
						@TempData["SuccessMessage"]
					</div>
					<button type="button" class="btn-close btn-close-white me-2 m-auto"
							data-bs-dismiss="toast"></button>
				</div>
			</div>
		}

		@if (TempData["ErrorMessage"] != null)
		{
			<div class="toast text-bg-danger border-0 show-toast">
				<div class="d-flex">
					<div class="toast-body">
						<strong>Error</strong><br />
						@TempData["ErrorMessage"]
					</div>
					<button type="button" class="btn-close btn-close-white me-2 m-auto"
							data-bs-dismiss="toast"></button>
				</div>
			</div>
		}

	</div>

	<!-- Toast script -->
	<script>
		document.addEventListener("DOMContentLoaded", function () {

		// Toast Notifications
		document.querySelectorAll(".show-toast").forEach(el => {
		new bootstrap.Toast(el, {
		delay: 3000
		}).show();
		});

		// Live Clock
		function updateClock() {
		const now = new Date();

		const formatted =
		now.toLocaleDateString("en-GB", {
		day: "2-digit",
		month: "short",
		year: "numeric"
		}) +
		" " +
		now.toLocaleTimeString();

		const liveDate = document.getElementById("liveDate");

		if (liveDate) {
		liveDate.textContent = formatted;
		}
		}

		updateClock();
		setInterval(updateClock, 1000);

		// Show Loader on Navigation
		document.addEventListener("click", function (e) {

		const link = e.target.closest("a");

		if (
		link &&
		link.href &&
		!link.href.includes("#") &&
		!link.href.startsWith("javascript:") &&
		link.target !== "_blank"
		) {
		const loader = document.getElementById("globalLoader");

		if (loader) {
		loader.style.display = "flex";
		loader.style.opacity = "1";
		}
		}
		});

		// Refresh Button
		$("#btnRefresh").on("click", function () {
		location.reload();
		});

		});

		// Hide Loader When Page Fully Loads
		window.addEventListener("load", function () {

		const loader = document.getElementById("globalLoader");

		if (!loader) return;

		setTimeout(() => {

		loader.style.opacity = "0";

		setTimeout(() => {
		loader.style.display = "none";
		}, 300);

		}, 200);

		});
	</script>

	@await RenderSectionAsync("Scripts", required: false)

</body>
</html>