@page
@model PlanningTool.NavExtension.Pages.Procurement.IndexModel
@{
	ViewData["Title"] = "Procurement Control Center";
}


<form method="post" class="erp-form">

	<div class="card border-0 shadow-sm erp-form">
		<div class="card-header bg-white border-bottom">
			<h5 class="mb-0 fw-semibold">
				<i class="fas fa-tag text-primary me-2"></i>
				Procurement Shipment Tagging
			</h5>
		</div>

		<div class="card-body">
			@{
				var hasHblData = Model.ImpexList?.Any(x => !string.IsNullOrWhiteSpace(x._ptHBLNo)) == true;
			}

			<div class="row g-3">
				<div class="col-12">

					<div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

						<!-- HBL Section -->
						<div>
							@if (hasHblData)
							{
								<div class="d-flex align-items-end gap-2">

									<div>
										<label class="erp-label mb-1">
											HBL No <span class="text-danger">*</span>
										</label>

										<select id="impexDropdown"
												name="ImpexID"
												class="form-select erp-control"
												style="min-width:300px;"
												required>
											<option value="">Select HBL No...</option>

											@foreach (var item in Model.ImpexList.Where(x => !string.IsNullOrWhiteSpace(x._ptHBLNo)))
											{
												<option value="@item.PK_ptImpexID"
														data-hbl="@item._ptHBLNo"
														data-container="@item._ptContainerNo"
														data-eta="@item._ptContainerETA?.ToString("yyyy-MM-dd HH:mm:ss")">
													@item._ptHBLNo
												</option>
											}
										</select>
									</div>

									@* <button type="submit"
											id="btnTagPO"
											asp-page-handler="Tag"
											class="btn btn-primary erp-btn">
										<i class="fas fa-link me-2"></i>
										Tag PO
									</button> *@
									<button id="btnTagPO"
											class="btn btn-primary"
											disabled>

										Tag PO

									</button>

								</div>

								<small id="tagInfo" class="text-muted d-block mt-2">
									<i class="fas fa-info-circle me-1"></i>
									Select an HBL and one or more POs to continue.
								</small>
							}
							else
							{
								<div class="alert alert-warning mb-0">
									<i class="fas fa-info-circle me-2"></i>
									No HBL Number is currently available. Please inform the ImPex Team to create a new Shipment Information record.
								</div>
							}
						</div>

						<!-- ETA Legend -->
						<div class="d-flex align-items-center gap-2 small">
							<span class="fw-semibold">
								ETA Legend
							</span>

							<span class="badge bg-danger">
								<i class="fas fa-triangle-exclamation me-1"></i>
								Overdue
							</span>

							<span class="badge bg-success">
								<i class="fas fa-shipping-fast me-1"></i>
								≤ 14 Days
							</span>

							<span class="badge bg-secondary">
								<i class="fas fa-calendar-alt me-1"></i>
								&gt; 14 Days
							</span>
						</div>

					</div>

				</div>
			</div>
		</div>
	</div>
	<input type="hidden" id="HBLNo" name="HBLNo">
	<input type="hidden" id="ContainerNo" name="ContainerNo">
	<input type="hidden" id="ParamCETA" name="ParamCETA">
	<br />
	@* Table display *@
	<div class="px-3">
		<table id="tblProcurement" class="table table-hover w-100">
			<thead class="sticky-top bg-white table-bordered" style="font-size:0.75rem;">
				<tr class="data-row">
					<th style="width:40px;"><input type="checkbox" id="selectAll" /></th>
					<th style="width:120px; text-align:left">PO No</th>
					<th style="width:220px; text-align:left">Vendor</th>
					<th style="width:120px; text-align:left">Item Code</th>
					<th style="width:300px; text-align:left">Description</th>
					<th style="width:120px; text-align:left">Outstanding Qty</th>

					@* Procurement Table *@
					@* <th style="width:120px;">Balance Qty</th> *@
					<th style="width:140px; text-align:left">Expected Qty</th>
					<th style="width:150px; text-align:center">HBL No</th>
					<th style="width:150px; text-align:center">Container No</th>
					<th style="width:120px; text-align:left">Dedon ETA</th>
					<th style="width:180px; text-align:left">Country of Origin</th>
					<th style="width:250px; text-align:left">Remarks</th>
					<th style="width:120px;" class="text-center">Action</th>
				</tr>
			</thead>

			<tbody style="font-size:0.75rem;">

				@if (Model.ProcurementList != null && Model.ProcurementList.Any())
				{
					@foreach (var item in Model.ProcurementList)
					{

						
						var totalDelivered = Model.ProcurementList
														.Where(x =>
															x.IDDocType == item.IDDocType &&
															x.IDDocNo == item.IDDocNo &&
															x.VendorName == item.VendorName &&
															x.ItemCode == item.ItemCode &&
															x.ItemDescription == item.ItemDescription)
														.Sum(x => x.ptPartialDelivered);

						bool disableCheckbox =
							totalDelivered >= item.OutstandingQty;

						
						<tr>
							<td>
								<input type="checkbox"
									   class="row-check po-checkbox"
									   name="SelectedRows"
									   value="@($"{item.IDDocType}|{item.IDDocNo}|{item.IDLineNo}|{item.ItemCode}")"
									   data-pd="@item.ptPartialDelivered"
									   data-outstanding="@item.OutstandingQty"
									   data-balance="@(item.OutstandingQty - item.ptPartialDelivered)"
								@(totalDelivered == item.OutstandingQty ? "disabled" : "") />
							</td>
							<td>@item.IDDocNo</td>
							<td>@item.VendorName</td>
							<td>@item.ItemCode</td>
							<td>@item.ItemDescription</td>
							<td>@item.OutstandingQty</td>
							@* Display Information from Procurement Table *@
							@* <td>@item.ptBalanceQty</td> *@
							<td>
								<span class="pd-text">@item.ptPartialDelivered</span>

								@{
									var balanceQty = item.OutstandingQty - item.ptPartialDelivered;
								}

								<input type="number"
									   class="form-control form-control-sm pd-input text-end"
									   name="PartialDeliveredValues[@($"{item.IDDocType}|{item.IDDocNo}|{item.IDLineNo}|{item.ItemCode}")]"
									   value="@item.ptPartialDelivered"
									   max="@item.OutstandingQty"
									   min="0"
									   step="0.01"
									   style="display:none; width:70px; padding:2px 4px; font-size:10px;" />

							</td>
							<td class="text-center">
								@if (!string.IsNullOrEmpty(item.ptHBLNo))
								{
									<span class="badge bg-primary text-dark">
										@item.ptHBLNo
									</span>
								}
								else
								{
									<span class="badge bg-warning text-dark">
										For Tagging
									</span>
								}
							</td>
							<td class="text-center">@item.ptContainerNo</td>
							<td>

								@if (item.ptContainerETA.HasValue)
								{
									var days = (item.ptContainerETA.Value.Date - DateTime.Today).Days;

									if (days < 0)
									{
										<span class="badge bg-danger text-bg-dark">
											<i class="fas fa-triangle-exclamation me-1"></i>
											@item.ptContainerETA.Value.ToString("yyyy-MM-dd")
										</span>
									}
									else if (days <= 14)
									{
										<span class="badge bg-success text-bg-dark">
											<i class="fas fa-shipping-fast me-1"></i>
											@item.ptContainerETA.Value.ToString("yyyy-MM-dd")
										</span>
									}
									else
									{
										<span class="badge bg-secondary text-bg-dark">
											<i class="fas fa-calendar-alt me-1"></i>
											@item.ptContainerETA.Value.ToString("yyyy-MM-dd")
										</span>
									}
								}

							</td>
							<td>@item.ptCountryOfOrigin</td>
							<td>@item.ptRemarks</td>
							<td class="text-center">
								@if (!string.IsNullOrEmpty(item.ptHBLNo))
								{
									<button type="submit"
											asp-page-handler="Untag"
											name="action"
											value="untag|@($"{item.IDDocType}|{item.IDDocNo}|{item.IDLineNo}|{item.ItemCode}|{item.ptHBLNo}|{item.ptContainerETA}")"
											formnovalidate
											style="border:none; background:none; cursor:pointer;"
											title="Untag"
											onclick="return confirm('Are you sure you want to untag this PO @item.IDDocNo?');">

										<i class="fa-solid fa-link-slash text-success"></i>

									</button>
								}
							</td>
						</tr>

					}
				}

				
			</tbody>
		</table>
	</div>
	<input type="hidden"
		   id="SelectedRowsJson"
		   name="SelectedRowsJson" />
</form>



@section Scripts
{
	<script>
		const selectedRows = new Set();
		const deliveryData = new Map();

		let table;

		const $impexDropdown = $('#impexDropdown');
		const $btnTagPO = $('#btnTagPO');
		const $tagInfo = $('#tagInfo');
		const $selectAll = $('#selectAll');

		function toggleTagButton() {

			const enabled =
				!!$impexDropdown.val() &&
				selectedRows.size > 0;

			$btnTagPO.prop('disabled', !enabled);
			$tagInfo.toggle(!enabled);
		}

		function populateHBLFields() {

			const $selected = $impexDropdown.find(':selected');

			$('#HBLNo').val($selected.data('hbl') || '');
			$('#ContainerNo').val($selected.data('container') || '');
			$('#ParamCETA').val($selected.data('eta') || '');
		}

		function updateSelectAllState() {

			const $checks = table
				.rows({ search: 'applied' })
				.nodes()
				.to$()
				.find('.row-check:not(:disabled)');

			const checked = $checks.filter(':checked').length;
			const total = $checks.length;

			$selectAll.prop({
				checked: total > 0 && checked === total,
				indeterminate: checked > 0 && checked < total
			});
		}

		function restoreSelections() {

			$('.row-check').each(function () {

				const $check = $(this);
				const row = $check.closest('tr');
				const id = $check.val();

				if (selectedRows.has(id)) {

					const balance =
						parseFloat($check.data('balance')) || 0;

					const savedQty =
						deliveryData.has(id)
							? deliveryData.get(id).qty
							: balance;

					$check.prop('checked', true);

					row.find('.pd-input')
						.val(savedQty)
						.attr('max', balance)
						.show();

					row.find('.pd-text').hide();

					row
						.addClass('table-warning')
						.removeClass('table-danger');

				} else {

					$check.prop('checked', false);

					row.find('.pd-input').hide();
					row.find('.pd-text').show();

					row.removeClass(
						'table-warning table-danger'
					);
				}
			});

			updateSelectAllState();
			toggleTagButton();
		}

		$(function () {

			$impexDropdown.select2();

			table = $('#tblProcurement').DataTable({
				pageLength: 25,
				scrollX: true,
				scrollY: '60vh',
				scrollCollapse: true,
				paging: true,
				autoWidth: false,
				fixedHeader: true,
				stateSave: true
			});

			table.on('draw', restoreSelections);

			// Column Filter

			const $searchInput =
				$('#tblProcurement_filter input');

			const $columnFilter =
				$('<select id="columnFilter"></select>');

			table.columns().every(function (index) {

				const title =
					$(this.header()).text().trim();

				if (title) {
					$columnFilter.append(
						`<option value="${index}">${title}</option>`
					);
				}
			});

			$('#tblProcurement_filter label')
				.contents()
				.filter((_, node) => node.nodeType === 3)
				.remove();

			$searchInput
				.attr('placeholder', 'Type to filter (F3)')
				.after($columnFilter)
				.on('input', function () {

					table.columns().search('');

					table
						.column($columnFilter.val())
						.search(this.value)
						.draw();
				});

			$columnFilter.on('change', () => {
				$searchInput.trigger('input');
			});

			// Restore Search

			const savedSearch =
				sessionStorage.getItem('tblProcurementSearch');

			if (savedSearch) {

				table.search(savedSearch).draw();
				$searchInput.val(savedSearch);
			}

			$searchInput.on('keyup', function () {

				sessionStorage.setItem(
					'tblProcurementSearch',
					this.value
				);
			});

			// Select All

			$selectAll.on('change', function () {

				table.rows({ search: 'applied' })
					.nodes()
					.to$()
					.find('.row-check:not(:disabled)')
					.prop('checked', this.checked)
					.trigger('change');
			});

			// Row Selection

			$(document).on('change', '.row-check', function () {

				const $check = $(this);
				const row = $check.closest('tr');

				const id = $check.val();
				const balance =
					parseFloat($check.data('balance')) || 0;

				const qtyInput =
					row.find('.pd-input');

				if (this.checked) {

					selectedRows.add(id);

					const savedQty =
						deliveryData.has(id)
							? deliveryData.get(id).qty
							: balance;

					qtyInput
						.val(savedQty)
						.attr('max', balance)
						.show();

					row.find('.pd-text').hide();

					row.addClass('table-warning');

					deliveryData.set(id, {
						id: id,
						qty: savedQty
					});

				} else {

					selectedRows.delete(id);
					deliveryData.delete(id);

					qtyInput.hide();

					row.find('.pd-text').show();

					row.removeClass(
						'table-warning table-danger'
					);
				}

				updateSelectAllState();
				toggleTagButton();
			});

			// Partial Delivered Validation

			$(document).on('input', '.pd-input', function () {

				const $input = $(this);
				const row = $input.closest('tr');

				const id =
					row.find('.row-check').val();

				const max =
					Number($input.attr('max')) || 0;

				const value =
					Number($input.val()) || 0;

				if (value > max) {

					alert(
						'Partial Delivered cannot exceed Outstanding Quantity!'
					);

					$input.val(max);

					row.addClass('table-danger');

				} else {

					row.removeClass('table-danger');
				}

				deliveryData.set(id, {
					id: id,
					qty: Number($input.val())
				});
			});

			// HBL Change

			$impexDropdown.on('change', function () {

				populateHBLFields();
				toggleTagButton();
			});

			// Initial Load

			restoreSelections();
			populateHBLFields();
			toggleTagButton();
		});
			$('form').on('submit', function () {

		$('#SelectedRowsJson').val(
			JSON.stringify(
				Array.from(deliveryData.values())
			)
		);
	});
	</script>
}
