@page
@model PlanningTool.NavExtension.Pages.Procurement.IndexModel
@{
	ViewData["Title"] = "Procurement Control Center";
}
<script>
	$(function () {

		// Select All (ignore disabled checkboxes)
		$("#selectAll").on("change", function () {
			$(".row-check:not(:disabled)")
				.prop("checked", this.checked)
				.trigger("change");
		});

		// Row checkbox change
		$(document).on("change", ".row-check", function () {

			const enabledChecks = $(".row-check:not(:disabled)");

			$("#selectAll").prop(
				"checked",
				enabledChecks.length > 0 &&
				enabledChecks.length === enabledChecks.filter(":checked").length
			);

			const row = $(this).closest("tr");
			const outstanding = parseFloat($(this).data("outstanding")) || 0;

			if (this.checked) {
				row.find(".pd-input")
					.val(outstanding)
					.attr("max", outstanding)
					.show();

				row.find(".pd-text").hide();
				row.addClass("table-warning");
			} else {
				row.find(".pd-input").hide();
				row.find(".pd-text").show();
				row.removeClass("table-warning table-danger");
			}
		});

		// Validate Partial Delivered
		$(document).on("input", ".pd-input", function () {

			const row = $(this).closest("tr");
			const max = parseFloat($(this).attr("max")) || 0;
			const value = parseFloat($(this).val()) || 0;

			if (value > max) {
				alert("Partial Delivered cannot exceed Outstanding Quantity!");
				$(this).val(max);
				row.addClass("table-danger");
			} else {
				row.removeClass("table-danger");
			}
		});

		// Populate hidden fields from selected HBL
		$("#impexDropdown").on("change", function () {

			const selected = $(this).find(":selected");

			$("#HBLNo").val(selected.data("hbl") || "");
			$("#ContainerNo").val(selected.data("container") || "");
			$("#ParamCETA").val(selected.data("eta") || "");
		});

		// Select2
		$("#impexDropdown").select2();

	});
</script>

<form method="post">
	<div class="form erp-form">
		<div class="col-md-4 ">
			<div class="d-flex align-items-center gap-2">

				@{
					var hasHBL = Model.ImpexList?.Any() == true;
				}

				@if (!hasHBL)
				{
					<div class="alert alert-info py-2 px-3 mb-0 small">
						No available HBL information found. Please coordinate with the
						<strong>ImPex Controller Team</strong> to create a new HBL record.
					</div>
				}
				else
				{
					<select id="impexDropdown"
							name="ImpexID"
							class="form-control form-control-sm"
							style="max-width:300px;"
							required>
						<option value="">-- Search & Select HBL No --</option>

						@foreach (var item in Model.ImpexList!)
						{
							<option value="@item.PK_ptImpexID"
									data-hbl="@item._ptHBLNo"
									data-container="@item._ptContainerNo"
									data-eta="@item._ptContainerETA?.ToString("yyyy-MM-dd")">
								@item._ptHBLNo
							</option>
						}
					</select>

					<button type="submit"
							asp-page-handler="Tag"
							class="btn btn-primary btn-sm">
						Tagged
					</button>
				}

			</div>
			<input type="hidden" id="HBLNo" name="HBLNo">
			<input type="hidden" id="ContainerNo" name="ContainerNo">
			<input type="hidden" id="ParamCETA" name="ParamCETA">
		</div>
	</div>
	<br />
	@* Table display *@
	<div class="table-responsive">
		<table id="tblProcurement" class="table table-hover w-100">
			<thead class="sticky-top bg-white table-bordered" style="font-size:0.75rem;">
				<tr class="data-row">
					<th style="width:40px;"><input type="checkbox" id="selectAll" /></th>
					<th style="width:120px;">PO No</th>
					<th style="width:220px;">Vendor</th>
					<th style="width:120px;">Item Code</th>
					<th style="width:300px;">Description</th>
					<th style="width:120px;">Outstanding Qty</th>

					@* Procurement Table *@
					@* <th style="width:120px;">Balance Qty</th> *@
					<th style="width:140px;">Partial Delivered</th>
					<th style="width:150px;">HBL No</th>
					<th style="width:150px;">Container No</th>
					<th style="width:120px;">Dedon ETA</th>
					<th style="width:180px;">Country of Origin</th>
					<th style="width:250px;">Remarks</th>
					<th style="width:120px;" class="text-center">Action</th>
				</tr>
			</thead>

			<tbody style="font-size:0.75rem;">

				@if (Model.ProcurementList != null && Model.ProcurementList.Any())
				{
					@foreach (var item in Model.ProcurementList)
					{
						<tr>
							<td>
								<input type="checkbox"
									   class="row-check"
									   name="SelectedRows"
									   value="@($"{item.IDDocType}|{item.IDDocNo}|{item.IDLineNo}|{item.ItemCode}")"
									   data-pd="@item.ptPartialDelivered"
									   data-outstanding="@item.OutstandingQty"
								@(!string.IsNullOrEmpty(item.ptHBLNo) && item.ptPartialDelivered == item.OutstandingQty ? "disabled" : "") />
							</td>
							<td>@item.IDDocNo</td>
							<td>@item.VendorName</td>
							<td>@item.ItemCode</td>
							<td>@item.ItemDescription</td>
							<td>@item.OutstandingQty</td>
							@* Display Information from Procurement Table *@
							@* <td>@item.ptBalanceQty</td> *@
							<td>
								<span class="pd-text">@item.ptPartialDelivered</span>

								<input type="number"
									   class="form-control form-control-sm pd-input text-end"
									   name="PartialDeliveredValues[@($"{item.IDDocType}|{item.IDDocNo}|{item.IDLineNo}|{item.ItemCode}")]"
									   value="@item.ptPartialDelivered"
									   max="@item.OutstandingQty"
									   min="0"
									   step="0.01"
									   style="display:none; width:70px; padding:2px 4px; font-size:10px;" />

							</td>
							<td>@item.ptHBLNo</td>
							<td>@item.ptContainerNo</td>
							<td>@item.ptContainerETA?.ToString("yyyy-MM-dd")</td>
							<td>@item.ptCountryOfOrigin</td>
							<td>@item.ptRemarks</td>
							<td class="text-center">
								@if (!string.IsNullOrEmpty(item.ptHBLNo))
								{
									<button type="submit"
											asp-page-handler="Untag"
											name="action"
											value="untag|@($"{item.IDDocType}|{item.IDDocNo}|{item.IDLineNo}|{item.ItemCode}|{item.ptHBLNo}|{item.ptContainerETA}")"
											formnovalidate
											style="border:none; background:none; cursor:pointer;"
											title="Untag"
											onclick="return confirm('Are you sure you want to untag this PO @item.IDDocNo?');">

										<i class="fa-solid fa-link-slash text-danger"></i>

									</button>
								}
							</td>
						</tr>

					}
				}

				
			</tbody>
		</table>
	</div>
</form>


@section Scripts {
	<script>
		$(function () {

			$('#impexDropdown').select2();

            
			const table = $('#tblProcurement').DataTable({
					pageLength: 25,
					scrollX: true,
					scrollY: '60vh',
					scrollCollapse: true,
					paging: true,
					autoWidth: false,
					fixedHeader: true
				});

				const savedSearch = sessionStorage.getItem('tblProcurementSearch');

				if (savedSearch) {
					table.search(savedSearch).draw();
					$('.dataTables_filter input').val(savedSearch);
				}

				$('.dataTables_filter input').on('keyup', function () {
					sessionStorage.setItem('tblProcurementSearch', this.value);
			});

		});
	</script>
}
