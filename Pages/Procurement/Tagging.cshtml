@page
@model PlanningTool.NavExtension.Pages.Procurement.TaggingModel
@{
	ViewData["Title"] = "Procurement Control Center";
}
<div class="erp-form">
	<form method="post">
		<div class="card border-0 shadow-sm">
			<div class="card-header bg-white border-bottom">
				<h5 class="mb-0 fw-semibold">
					<i class="fas fa-tag text-primary me-2"></i>
					Procurement Shipment Tagging
				</h5>
			</div>

			<div class="card-body">
				@{
					var hasHblData = Model.ImpexList?.Any(x => !string.IsNullOrWhiteSpace(x._ptHBLNo)) == true;
				}

				<div class="row g-3">
					<div class="col-12">

						<div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

							<!-- HBL Section -->
							<div>
								@if (hasHblData)
								{
									<div class="d-flex align-items-end gap-2">

										<div>
											<label class="erp-label mb-1">
												HBL No <span class="text-danger">*</span>
											</label>

											<select id="impexDropdown"
													name="ImpexID"
													class="form-select erp-control"
													style="min-width:300px;"
													required>
												<option value="">Select HBL No...</option>

												@foreach (var item in Model.ImpexList.Where(x => !string.IsNullOrWhiteSpace(x._ptHBLNo)))
												{
													<option value="@item.PK_ptImpexID"
															data-hbl="@item._ptHBLNo"
															data-container="@item._ptContainerNo"
															data-eta="@item._ptContainerETA?.ToString("yyyy-MM-dd HH:mm:ss")">
														@item._ptHBLNo
													</option>
												}
											</select>
										</div>
										<button id="btnTagPO"
												type="button"
												class="btn btn-sm btn-primary erp-btn"
												disabled>
											<i class="fas fa-link me-1"></i>
											Tag Selected PO
										</button>


									</div>

									<small id="tagInfo" class="text-muted d-block mt-2">
										<i class="fas fa-info-circle me-1"></i>
										Select an HBL and one or more POs to continue.
									</small>
								}
								else
								{
									<div class="alert alert-warning mb-0">
										<i class="fas fa-info-circle me-2"></i>
										No HBL Number is currently available. Please inform the ImPex Team to create a new Shipment Information record.
									</div>
								}
							</div>

							<!-- ETA Legend -->
							<div class="d-flex align-items-center gap-2 small">
								<span class="fw-semibold">
									ETA Legend
								</span>

								<span class="badge bg-danger">
									<i class="fas fa-triangle-exclamation me-1"></i>
									Overdue
								</span>

								<span class="badge bg-success">
									<i class="fas fa-shipping-fast me-1"></i>
									≤ 14 Days
								</span>

								<span class="badge bg-secondary">
									<i class="fas fa-calendar-alt me-1"></i>
									&gt; 14 Days
								</span>
							</div>

						</div>

					</div>
				</div>
			</div>
		</div>

		<table id="tblProcurement" class="table table-hover w-100">
			<thead class="sticky-top bg-white table-bordered" style="font-size:0.75rem;">
				<tr class="data-row">
					<th style="width:40px;"><input type="checkbox" id="selectAll" /></th>

					<th style="width:120px; text-align:left; display:none">Doc Type</th>
					<th style="width:120px; text-align:left">PO No</th>
					<th style="width:120px; text-align:left; display:none">Line No</th>
					<th style="width:220px; text-align:left">Vendor</th>
					<th style="width:120px; text-align:left">Item Code</th>
					<th style="width:300px; text-align:left">Description</th>
					<th style="width:120px; text-align:right">Outstanding Qty</th>
					<th style="width:120px; text-align:right; display:none">Balance Qty</th>
					<th style="width:140px; text-align:right">Expected Qty</th>
					<th style="width:150px; text-align:center">HBL No</th>
					<th style="width:150px; text-align:center">Container No</th>
					<th style="width:120px; text-align:left">Dedon ETA</th>
					<th style="width:180px; text-align:left">Country of Origin</th>
					<th style="width:250px; text-align:left">Remarks</th>
					<th style="width:120px;" class="text-center">Action</th>
				</tr>
			</thead>

			<tbody style="font-size:0.75rem;">

				@if (Model.ProcurementList != null && Model.ProcurementList.Any())
				{
					@foreach (var item in Model.ProcurementList)
					{
						<tr>
							<td>
								<input type="checkbox" id="selectAll"
									   class="row-check po-check"
									   data-doctype="@item.IDDocType"
									   data-docno="@item.IDDocNo"
									   data-line="@item.IDLineNo"
									   data-item="@item.ItemCode"
									   data-vendor="@item.VendorName"
									   data-description="@item.ItemDescription"
									   data-outstanding="@item.OutstandingQty"
									   data-balanceqty="@item.ptBalanceQty"
								@((item.ptBalanceQty == 0 && !string.IsNullOrWhiteSpace(item.ptHBLNo)) ? "disabled" : "") />

							</td>
							<td style="display:none;">@item.IDDocType</td>
							<td>@item.IDDocNo</td>
							<td style="display:none;">@item.IDLineNo</td>
							<td>@item.VendorName</td>
							<td>@item.ItemCode</td>
							<td>@item.ItemDescription</td>
							<td class="text-end">@item.OutstandingQty</td>
							<td class="text-end" style="display: none">@item.ptBalanceQty</td>
							<td class="text-end">
								<span class="pd-text text-end">@item.ptPartialDelivered</span>
							</td>
							<td class="text-center">
								@if (!string.IsNullOrEmpty(item.ptHBLNo))
								{
									<span class="badge bg-primary">
										@item.ptHBLNo
									</span>
								}
							</td>
							<td class="text-center">@item.ptContainerNo</td>
							<td>

								@if (item.ptContainerETA.HasValue)
								{
									var days = (item.ptContainerETA.Value.Date - DateTime.Today).Days;

									if (days < 0)
									{
										<span class="badge bg-danger text-bg-dark">
											<i class="fas fa-triangle-exclamation me-1"></i>
											@item.ptContainerETA.Value.ToString("yyyy-MM-dd")
										</span>
									}
									else if (days <= 14)
									{
										<span class="badge bg-success text-bg-dark">
											<i class="fas fa-shipping-fast me-1"></i>
											@item.ptContainerETA.Value.ToString("yyyy-MM-dd")
										</span>
									}
									else
									{
										<span class="badge bg-secondary text-bg-dark">
											<i class="fas fa-calendar-alt me-1"></i>
											@item.ptContainerETA.Value.ToString("yyyy-MM-dd")
										</span>
									}
								}

							</td>
							<td>@item.ptCountryOfOrigin</td>
							<td>@item.ptRemarks</td>
							<td class="text-center">
								@if (!string.IsNullOrEmpty(item.ptHBLNo))
								{

									<button type="submit"
											asp-page-handler="Untag"
											name="action"
											value="untag|@($"{item.IDDocType}|{item.IDDocNo}|{item.IDLineNo}|{item.ItemCode}|{item.ptHBLNo}|{item.ptContainerETA}")"
											formnovalidate
											style="border:none; background:none; cursor:pointer;"
											title="Untag"
											onclick="return confirm('Are you sure you want to untag this PO @item.IDDocNo?');">

										<i class="fa-solid fa-link-slash text-success"></i>

									</button>

								}
							</td>
						</tr>
					}
				}

			</tbody>
		</table>
	</form>
	<form id="frmProcurement" method="post">
		<input type="hidden" id="SelectedRowsJson" name="SelectedRowsJson" />

		@* Modal Popup Confirmation *@
		<div class="modal fade" id="tagModal" tabindex="-1">
			<div class="modal-dialog modal-xl modal-dialog-scrollable">
				<div class="modal-content shadow-sm border-0">

					<!-- Header -->
					<div class="modal-header bg-light border-bottom">
						<h5 class="modal-title fw-semibold">
							<i class="fas fa-tag text-primary me-2"></i>
							Procurement Shipment Tagging
						</h5>

						<button type="button"
								class="btn-close"
								data-bs-dismiss="modal">
						</button>
					</div>

					<div class="modal-body">

						<!-- Shipment Information -->
						<div class="card border mb-3">
							<div class="card-header bg-white fw-semibold">
								Shipment Information
							</div>

							<div class="card-body">

								<div class="row g-3">

									<div class="col-md-3">
										<label class="form-label small fw-semibold">
											HBL No
										</label>

										<input id="modalHBL" name="HBLNo"
											   class="form-control form-control-sm bg-light"
											   readonly />
									</div>

									<div class="col-md-4">
										<label class="form-label small fw-semibold">
											Container No
										</label>

										<input id="modalContainer" name="ContainerNo"
											   class="form-control form-control-sm bg-light"
											   readonly />
									</div>

									<div class="col-md-3">
										<label class="form-label small fw-semibold">
											Dedon ETA
										</label>

										<input id="modalDedonETA" name="ParamCETA"
											   class="form-control form-control-sm bg-light"
											   readonly />
									</div>

									<div class="col-md-12">
										<label class="form-label small fw-semibold">
											Remarks
										</label>

										<textarea id="modalRemarks"
												  class="form-control form-control-sm"
												  rows="3"
												  placeholder="Enter shipment remarks..."></textarea>
									</div>

								</div>

							</div>
						</div>

						<!-- Selected Purchase Orders -->
						<div class="card border">

							<div class="card-header bg-white fw-semibold">
								Selected Purchase Orders
							</div>

							<div class="card-body p-0">

								<table id="tblSelected"
									   class="table table-sm table-hover table-bordered mb-0">

									<thead class="table-light">
										<tr style="font-size:0.80rem;">
											<th style="width:140px;">PO No</th>
											<th style="width:220px;">Vendor</th>
											<th style="width:120px;">Item Code</th>
											<th>Description</th>
											<th style="width:120px;" class="text-end">
												Outstanding
											</th>
											<th style="width:150px;" class="text-end">
												Expected Qty
											</th>
										</tr>

									</thead>

									<tbody style="font-size:0.80rem;">
									</tbody>

								</table>

							</div>

						</div>

					</div>

					<!-- Footer -->
					<div class="modal-footer bg-light">

						<button type="button" class="btn btn-primary erp-btn"
								data-bs-dismiss="modal">
							Cancel
						</button>

						<button id="btnProceed" type="submit" asp-page-handler="Tag"
								class="btn btn-success erp-btn">
							<i class="fas fa-save me-1"></i>
							Proceed
						</button>

					</div>

				</div>
			</div>
		</div>

	</form>
</div>

@section Scripts
{
	<script>

		let selectedPO = [];
		const $impexDropdown = $('#impexDropdown');

		// ==============================
		// HBL List with Search
		// ==============================
		function toggleTagButton() {

			const enabled =
				!!$impexDropdown.val() &&
				selectedRows.size > 0;

			$btnTagPO.prop('disabled', !enabled);
			$tagInfo.toggle(!enabled);
		}
		function populateHBLFields() {

			const $selected = $impexDropdown.find(':selected');

			$('#HBLNo').val($selected.data('hbl') || '');
			$('#ContainerNo').val($selected.data('container') || '');
			$('#ParamCETA').val($selected.data('eta') || '');
		}


		$(function () {

			$impexDropdown.select2();

			// ==============================
			// DataTable with Responsive and Scroll
			// ==============================

			function getTableHeight() {
				return ($(window).height() * 0.6) + 'px';
			}

			const table = $('#tblProcurement').DataTable({
				pageLength: 25,
				scrollX: true,
				scrollY: getTableHeight(),
				scrollCollapse: true,
				paging: true,
				autoWidth: false,
				fixedHeader: true,
				stateSave: true,
				responsive: true

			});

			$(window).on('resize', function () {
				table.settings()[0].oScroll.sY = getTableHeight();
				table.columns.adjust().draw();
				table.fixedHeader.adjust();
			});

			// ==============================
			// Column Filter
			// ==============================

			const $filter = $('#tblProcurement_filter');
			const $searchInput = $filter.find('input');

			const $columnFilter = $('<select>', {
				id: 'columnFilter'
			});

			// Generate options for each column
			table.columns().every(function (index) {

				// Hide Doc Type, Line No, Action from filter dropdown
				if ([1, 3, 15].includes(index)) {
					return;
				}

				const title = $(this.header()).text().trim();

				if (title) {
					$columnFilter.append(
						$('<option>', {
							value: index,
							text: title
						})
					);
				}
			});

			// Remove "Search:"
			$filter.find('label')
				.contents()
				.filter((_, node) => node.nodeType === 3)
				.remove();

			// Align controls
			$filter.css({
				display: 'flex',
				alignItems: 'center'
			});

			// Search box
			$searchInput.attr(
				'placeholder',
				'Type to filter (F3)'
			);

			// Insert dropdown beside search
			$searchInput.after($columnFilter);

			// Filter selected column
			function applyFilter() {

				table.columns().search('');

				table
					.column(Number($columnFilter.val()))
					.search($searchInput.val())
					.draw();
			}

			$searchInput.on('input', applyFilter);
			$columnFilter.on('change', applyFilter);

			// Fix header width after rendering
			setTimeout(() => {
				table.columns.adjust().draw(false);
			}, 100);

			// ==============================
			// Row Selection
			// ==============================

			$(document).on('change', '.row-check', function () {

				const $checkbox = $(this);
				const $row = $checkbox.closest('tr');

				const item = {
					IDDocType: $checkbox.data('doctype'),
					IDDocNo: $checkbox.data('docno'),
					IDLineNo: $checkbox.data('line'),
					ItemCode: $checkbox.data('item'),

					VendorName: $row.find('td:eq(4)').text().trim(),
					ItemDescription: $checkbox.data('description'),

					ptBalanceQty: Number($checkbox.data('balanceqty'))
				};

				if (this.checked) {

					selectedPO.push(item);

				} else {

					selectedPO = selectedPO.filter(x =>
						!(x.IDDocNo === item.IDDocNo &&
						  x.IDLineNo === item.IDLineNo &&
						  x.ItemCode === item.ItemCode)
					);
				}

				const hasHBL = $('#impexDropdown').val() !== '';

				$('#btnTagPO').prop(
					'disabled',
					selectedPO.length === 0 || !hasHBL
				);

			});


			// ==============================
			// HBL When Changed.
			// ==============================
			$('#impexDropdown').on('change', function () {

				const hasHBL = $(this).val() !== '';

				$('#btnTagPO').prop(
					'disabled',
					selectedPO.length === 0 || !hasHBL
				);
			});

			// ==============================
			// Open Modal
			// ==============================
			$('#btnTagPO').on('click', function () {

				const $tbody = $('#tblSelected tbody');

				$tbody.empty();

				selectedPO.forEach(item => {

					$tbody.append(`
						<tr
							data-doctype="${item.IDDocType}"
							data-docno="${item.IDDocNo}"
							data-line="${item.IDLineNo}"
							data-item="${item.ItemCode}">
							data-description="${item.ItemDescription}">

							<td>${item.IDDocNo}</td>
							<td>${item.VendorName}</td>
							<td>${item.ItemCode}</td>
							<td>${item.ItemDescription}</td>

							<td class="text-end">
								${item.ptBalanceQty}
							</td>

							<td>
							 <input type="number"
							   class="form-control form-control-sm pd text-end"
							   value="${item.ptBalanceQty}"
							   min="1"
							   max="${item.ptBalanceQty}"
							   step="0.01"
							   required
							   data-balance="${item.ptBalanceQty}">

		
							</td>

						</tr>
					`);
				});

				const selected =
					$('#impexDropdown option:selected');

				$('#modalHBL').val(
					selected.data('hbl') || ''
				);

				$('#modalContainer').val(
					selected.data('container') || ''
				);

				const eta = selected.data('eta');

				$('#modalDedonETA').val(
					eta ? eta.toString().substring(0, 10) : ''
				);

				$('#tagModal').modal('show');
			});

			// ==============================
			// Prepare JSON Before Submit
			// ==============================

			$('#btnProceed').on('click', function () {

				const payload = [];

				$('#tblSelected tbody tr').each(function () {

					payload.push({

						ptHBLNo: String($('#modalHBL').val() || ''),
						ptContainerNo: String($('#modalContainer').val() || ''),

						IDDocType: Number($(this).data('doctype')),
						IDDocNo: String($(this).data('docno')),
						IDLineNo: Number($(this).data('line')),
						ItemCode: String($(this).data('item')),
						ItemDescription: $(this).find('td:eq(3)').text().trim(),
						ptPartialDelivered: Number( $(this).find('.pd').val() || 0 ),
						ptContainerETA: $('#modalDedonETA').val(),
						ptRemarks: String($('#modalRemarks').val() || '')
					});

				});

				$('#SelectedRowsJson').val(
					JSON.stringify(payload)
				);

				console.log(payload);
			});

			// Check/Uncheck All Rows
			$('#selectAll').on('change', function () {

				$('.row-check:not(:disabled)')
					.prop('checked', this.checked)
					.trigger('change');
			});

		});

	</script>
}