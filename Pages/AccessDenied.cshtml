@page
@model PlanningTool.NavExtension.Pages.AccessDeniedModel
@{
	Layout = null;

	var currentUser = User?.Identity?.Name;
	
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Access Denied</title>

	<link rel="stylesheet"
		  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

	<link rel="stylesheet"
		  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

	<style>
			:root {
				--nav-blue: #0078D4;
				--nav-light: #F3F7FB;
				--nav-border: #D6E4F0;
				--nav-text: #323130;
			}

			body {
				margin: 0;
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				background: linear-gradient(135deg,#f5f8fc,#eef3f8);
				font-family: "Segoe UI", sans-serif;
				color: var(--nav-text);
			}

			.access-container {
				width: 100%;
				max-width: 850px;
				padding: 20px;
			}

			.access-card {
				background: #fff;
				border-radius: 12px;
				overflow: hidden;
				box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.08);
			}

			.header {
				background: var(--nav-blue);
				color: white;
				padding: 20px 30px;
			}

				.header h3 {
					margin: 0;
					font-size: 1.4rem;
					font-weight: 600;
				}

			.content {
				display: flex;
				gap: 30px;
				padding: 35px;
			}

			.icon-panel {
				flex: 0 0 120px;
				text-align: center;
			}

				.icon-panel i {
					font-size: 5rem;
					color: #dc3545;
				}

			.details {
				flex: 1;
			}

				.details h2 {
					font-weight: 600;
					margin-bottom: 15px;
				}

				.details p {
					color: #605e5c;
					line-height: 1.7;
				}

			.user-panel {
				background: var(--nav-light);
				border-left: 4px solid var(--nav-blue);
				padding: 15px;
				margin-top: 20px;
				border-radius: 6px;
			}

			.user-label {
				font-size: .75rem;
				color: #605e5c;
				text-transform: uppercase;
				letter-spacing: .6px;
			}

			.footer {
				border-top: 1px solid #eee;
				padding: 15px 30px;
				background: #fafafa;
				font-size: .85rem;
				color: #605e5c;
			}

			.status-tag {
				display: inline-block;
				padding: 5px 12px;
				border-radius: 15px;
				background: #fde7e9;
				color: #c50f1f;
				font-size: .8rem;
				font-weight: 600;
				margin-bottom: 15px;
			}
	</style>
</head>
<body>

	<div class="access-container">

		<div class="access-card">

			<div class="header">
				<h3>
					<i class="bi bi-box-seam me-2"></i>
					DEDON Planning Tool
				</h3>
			</div>

			<div class="content">

				<div class="icon-panel">
					<i class="bi bi-shield-lock"></i>
				</div>

				<div class="details">

					<div class="status-tag">
						ACCESS DENIED
					</div>

					<h2>You don't have permission to access this module</h2>

					
					<p>
						Your account is authenticated successfully, however your current
						user profile does not have sufficient privileges to access this module.
					</p>

					<p>
						Please contact the <strong>IT Administrator</strong> to request access.
						Once your access has been granted, click
						<strong>Refresh Access</strong> below to reload the page.
					</p>


					<div class="user-panel">

						<div class="user-label">
							Current Windows Account
						</div>

						<div>
							<strong>@currentUser</strong>
						</div>
					</div>
					<div class="mt-4 d-flex gap-2">						
						<div class="mt-4 d-flex gap-2">
							<a href="@Model.ReturnUrl"
							   class="btn btn-primary">
								<i class="bi bi-arrow-clockwise me-2"></i>
								Refresh Access
							</a>
						</div>
					</div>
				</div>
			</div>
			<div class="footer">
				DEDON Planning Tool NAV Extension •
				Access Control Verification •
				@DateTime.Now.ToString("MMMM dd, yyyy HH:mm")
			</div>

		</div>
	</div>
</body>
</html>