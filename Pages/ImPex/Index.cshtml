@page
@model PlanningTool.NavExtension.Pages.ImPex.IndexModel
@{
	ViewData["Title"] = "ImPex Center";
}
<div class="container-fluid">
	<form id="frmImpex" method="post" asp-page-handler="Save">

		<input type="hidden" asp-for="Impex.PK_ptImpexID" />

		<div class="card border-0 shadow-sm">
			<div class="card-header bg-white border-bottom">
				<h5 class="mb-0 fw-semibold">
					<i class="fas fa-file-import text-primary me-2"></i>
					Shipment Information
				</h5>
			</div>

			<div class="card-body">
				<div class="row g-3">
					<!-- Column 1 -->
					<div class="col-lg-4">

						<div class="mb-3">
							<label class="erp-label">
								HBL No <span class="text-danger">*</span>
							</label>

							<input asp-for="Impex._ptHBLNo"
								   id="HBLNo"
								   class="form-control erp-control erp-input"
								   placeholder="HBL Number"
								   onblur="checkHblExists()"
								   required />

							<small id="hblMessage"></small>
						</div>

						<div>
							<label class="erp-label">
								Dedon ETA <span class="text-danger">*</span>
							</label>

							<input asp-for="Impex._ptContainerETA"
								   type="date"
								   class="form-control erp-control erp-input"
								   min="@DateTime.Today.ToString("yyyy-MM-dd")"
								   required />
						</div>

					</div>

					<!-- Column 2 -->
					<div class="col-lg-4">

						<div class="mb-3">
							<label class="erp-label">
								Container No <span class="text-danger">*</span>
							</label>

							<input asp-for="Impex._ptContainerNo"
								   class="form-control erp-control erp-input"
								   placeholder="Container Number"
								   required />
						</div>

						<div>
							<label class="erp-label">
								Country of Origin <span class="text-danger">*</span>
							</label>

							<select asp-for="Impex._ptCountryOfOrigin"
									class="form-select erp-control erp-dropdown"
									required>
								<option value="">Select Country...</option>

								@foreach (var country in Model.CountryList)
								{
									<option value="@country.Value">
										@country.Text
									</option>
								}
							</select>

							<span asp-validation-for="Impex._ptCountryOfOrigin"
								  class="text-danger small"></span>
						</div>

					</div>

					<!-- Column 3 -->
					<div class="col-lg-4">

						<label class="erp-label">
							Remarks
						</label>

						<textarea asp-for="Impex._ptRemarks" style="height: 105px"
								  class="form-control erp-control erp-textarea"
								  rows="5"
								  placeholder="Remarks">
					</textarea>

					</div>

				</div>

			</div>
		</div>

		<div class="mt-3">

			@if (Model.Impex != null && Model.Impex.PK_ptImpexID > 0)
			{
				<button id="btnUpdate"
						type="submit"
						class="btn btn-success px-4 shadow-sm erp-btn"
						style="display:none;">
					<i class="fas fa-save me-1"></i>
					Update
				</button>

				<a asp-page="./Index"
				   class="btn btn-outline-secondary px-4 erp-btn">
					<i class="fas fa-times me-1"></i>
					Cancel
				</a>
			}
			else
			{
				<button id="btnAdd"
						type="submit"
						class="btn btn-primary px-4 shadow-sm erp-btn">
					<i class="fas fa-plus-circle me-1"></i>
					Add New Record
				</button>
			}

		</div>

	</form>
	<br />
	<div class="table-responsive">

		<table id="tblImpexCenter" class="table table-hover w-100 ">

			<thead class="sticky-top bg-white table-bordered">
				<tr style="font-size: 0.8em">
					<th class="text-center">No</th>
					<th>HBL No</th>
					<th>Container No</th>
					<th>Dedon ETA</th>
					<th>Country Of Origin</th>
					<th>Remarks</th>
					<th>Created By</th>
					<th>Date Created</th>
					<th>Modified By</th>
					<th>Date Modified</th>
					@* <th>PO No Tagged</th> *@
					<th class="text-center">Status</th>
					<th class="text-center">Action</th>
				</tr>
			</thead>

			<tbody>

				@{
					int counter = 1;
				}

				@if (Model.ImpexList != null && Model.ImpexList.Any())
				{
					foreach (var item in Model.ImpexList)
					{
						<tr style="font-size: 0.8em">
							<td class="text-center">@counter</td>

							<td>@item._ptHBLNo</td>
							<td>@item._ptContainerNo</td>
							<td>@item._ptContainerETA?.ToString("yyyy-MM-dd")</td>
							<td>@item._ptCountryOfOrigin</td>
							<td class="erp-truncate">@item._ptRemarks</td>
							<td>@item._ptCreatedBy</td>
							<td>@item._ptCreatedDate</td>
							<td>@item._ptModifiedBy</td>
							<td>@item._ptModifiedDate</td>
							<td class="text-center">
								@{
									string statusText;
									string statusIcon;
									string statusColor;

									switch (item._ptStatus)
									{
										case 1:
											statusText = "Tagged";
											statusIcon = "fa-tag";
											statusColor = "bg-primary";
											break;

										case 2:
											statusText = "Completed";
											statusIcon = "fa-check-circle";
											statusColor = "bg-success";
											break;

										default:
											statusText = "For Tagging";
											statusIcon = "fa-clock";
											statusColor = "bg-warning";
											break;
									}
								}

								<span class="badge @statusColor text-dark status-badge">
									<i class="fas @statusIcon me-1"></i>
									@statusText
								</span>

							</td>

							<td class="text-center">
								@{
									// Bind the tagged documents for the current HBL No
									var taggedDocs = string.Join(", ",
										Model.ProcurementList
											.Where(x => x._ptHBLNo == item._ptHBLNo && x._ptStatus != 0)
											.Select(x => x._ptDocNo)
											.Distinct());
								}
								@{
									var editUrl = Url.Page("./Index", new { id = item.PK_ptImpexID });
								}

								@if (item._ptStatus != 2)
								{
									<a hrefass="text-secondary"
									   title="Edit HBL"
									   onclick="
										if (@item._ptStatus == 1) {
										if (confirm('Are you sure you want to edit this data?\n\n⚠ This HBL is already tagged with: @taggedDocs\n\nDo you want to continue?')) {
										window.location.href='@editUrl';
										}
										}
										else {
										window.location.href='@editUrl';
										}
										return false;">
										<i class="fa-solid fa-pen-to-square"></i>
									</a>
								}
								else
								{
									<span class="text-success" title="Locked">
										<i class="fa-solid fa-lock"></i>
									</span>
								}
							</td>
						</tr>

						counter++;
					}
				}

			</tbody>
		</table>
	</div>
</div>
@section Scripts {
	<script>
		let impexTable;

		function getTableHeight() {
			return ($(window).height() * 0.6) + 'px';
		}

		function createDataTable(selector) {
			return $(selector).DataTable({
				pageLength: 25,
				paging: true,
				scrollX: true,
				scrollY: getTableHeight(),
				scrollCollapse: true,
				autoWidth: false,
				fixedHeader: true,
				responsive: true
			});
		}

		function addColumnFilter(table, tableId) {

			const $filter = $(`${tableId}_filter`);
			const $searchInput = $filter.find('input');
			const $columnFilter = $('<select class="columnFilter"></select>');

			// Remove "Search:"
			$filter.find('label')
				.contents()
				.filter((_, node) => node.nodeType === 3)
				.remove();

			$searchInput.attr('placeholder', 'Type to filter (F3)');

			table.columns().every(function (index) {

				const title = $(this.header()).text().trim();

				if (title) {
					$columnFilter.append(
						`<option value="${index}">${title}</option>`
					);
				}
			});

			$searchInput.after($columnFilter);

			const filterData = () => {

				table.columns().search('');

				table
					.column(Number($columnFilter.val()))
					.search($searchInput.val())
					.draw();
			};

			$searchInput.on('input', filterData);
			$columnFilter.on('change', filterData);
		}

		async function checkHblExists() {

			const hblNo = $('#HBLNo').val().trim();
			const $btnAdd = $('#btnAdd');
			const $msg = $('#hblMessage');

			if (!hblNo) {
				$msg.empty();
				$btnAdd.prop('disabled', false);
				return;
			}

			try {

				const response = await fetch(
					`?handler=CheckHbl&hblNo=${encodeURIComponent(hblNo)}`
				);

				const exists = await response.json();

				$msg
					.text(exists
						? '⚠ HBL No already exists.'
						: '✓ HBL No available.')
					.css('color', exists ? 'red' : 'green');

				$btnAdd.prop('disabled', exists);

			} catch (error) {

				console.error(error);

				$msg
					.text('Unable to validate HBL No.')
					.css('color', 'red');
			}
		}


		$(document).ready(function () {

			// ====================
			// DataTable
			// ====================

			impexTable = createDataTable('#tblImpexCenter');

			addColumnFilter(
				impexTable,
				'#tblImpexCenter'
			);


			// ====================
			// Select2
			// ====================

			$('#countryOfOrigin').select2();


			// ====================
			// Track Form Changes
			// ====================

			const originalData = $('#frmImpex').serialize();

			$('#frmImpex').on(
				'input change',
				'input, select, textarea',
				function () {

					const changed =
						$('#frmImpex').serialize() !== originalData;

					$('#btnUpdate').toggle(changed);
				}
			);


			// ====================
			// Restore Search
			// ====================

			const storageKey = 'tblImPexSearch';
			const $searchBox = $('.dataTables_filter input');

			const savedSearch =
				sessionStorage.getItem(storageKey);

			if (savedSearch) {

				impexTable
					.search(savedSearch)
					.draw();

				$searchBox.val(savedSearch);
			}

			$searchBox.on('keyup', function () {

				sessionStorage.setItem(
					storageKey,
					this.value
				);
			});


			// ====================
			// HBL Validation
			// ====================

			$('#HBLNo').on(
				'blur',
				checkHblExists
			);

		/* ==============================
		   Apply CSS Color
		============================== */
		$('.eta-date').each(function () {

			const etaValue = $(this).data('eta');

			if (!etaValue) return;

			const etaDate = new Date(etaValue);
			const today = new Date();

			today.setHours(0, 0, 0, 0);
			etaDate.setHours(0, 0, 0, 0);

			const days = Math.ceil(
				(etaDate - today) / (1000 * 60 * 60 * 24)
			);

			let color;

			if (days < 0) {
				color = '#dc3545'; // Overdue
			}
			else if (days <= 14) {
				color = '#198754'; // <=14 Days
			}
			else {
				color = '#6c757d'; // >14 Days
			}

			$(this).css({
				backgroundColor: color,
				color: '#fff',
				padding: '3px 8px',
				borderRadius: '4px',
				fontWeight: '600',
				fontSize: '0.8em',
				display: 'inline-block'
			});

			});
		});
	</script>
}