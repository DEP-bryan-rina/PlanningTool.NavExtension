@page
@model PlanningTool.NavExtension.Pages.ImPex.IndexModel
@{
	ViewData["Title"] = "ImPex Control Center";
}

<script>
	async function checkHblExists() {

		const hblNo = document.getElementById("HBLNo").value.trim();
		const btnAdd = document.getElementById("btnAdd");
		const msg = document.getElementById("hblMessage");

		if (!hblNo) {
			msg.innerHTML = "";
			if (btnAdd) btnAdd.disabled = false;
			return;
		}

		const response = await fetch(`?handler=CheckHbl&hblNo=${encodeURIComponent(hblNo)}`);
		const exists = await response.json();

		if (exists) {
			msg.innerHTML = "⚠ HBL No already exists.";
			msg.style.color = "red";	
			if (btnAdd) btnAdd.disabled = true;
		} else {
			msg.innerHTML = "✓ HBL No available.";
			msg.style.color = "green";
			if (btnAdd) btnAdd.disabled = false;
		}
	}
	$(document).ready(function () {

		const originalData = $('#frmImpex').serialize();

		$('#frmImpex').on('input change', 'input, select, textarea', function () {

			const currentData = $('#frmImpex').serialize();

			$('#btnUpdate').toggle(currentData !== originalData);
		});

	});
</script>

<form id="frmImpex" method="post" asp-page-handler="Save" class="erp-form">

	<input type="hidden" asp-for="Impex.PK_ptImpexID" />

	<div class="card border-0 shadow-sm">
		<div class="card-header bg-white border-bottom">
			<h5 class="mb-0 fw-semibold">
				<i class="fas fa-file-import text-primary me-2"></i>
				Shipment Information
			</h5>
		</div>

		<div class="card-body">
			<div class="row g-3">
				<!-- Column 1 -->
				<div class="col-lg-4">

					<div class="mb-3">
						<label class="erp-label">
							HBL No <span class="text-danger">*</span>
						</label>

						<input asp-for="Impex._ptHBLNo"
							   id="HBLNo"
							   class="form-control erp-control"
							   placeholder="HBL Number"
							   onblur="checkHblExists()"
							   required />

						<small id="hblMessage"></small>
					</div>

					<div>
						<label class="erp-label">
							Dedon ETA <span class="text-danger">*</span>
						</label>

						<input asp-for="Impex._ptContainerETA"
							   type="date"
							   class="form-control erp-control"
							   min="@DateTime.Today.ToString("yyyy-MM-dd")"
							   required />
					</div>

				</div>

				<!-- Column 2 -->
				<div class="col-lg-4">

					<div class="mb-3">
						<label class="erp-label">
							Container No <span class="text-danger">*</span>
						</label>

						<input asp-for="Impex._ptContainerNo"
							   class="form-control erp-control"
							   placeholder="Container Number"
							   required />
					</div>

					<div>
						<label class="erp-label">
							Country of Origin <span class="text-danger">*</span>
						</label>

						<select asp-for="Impex._ptCountryOfOrigin"
								class="form-select erp-control"
								required>
							<option value="">Select Country...</option>

							@foreach (var country in Model.CountryList)
							{
								<option value="@country.Value">
									@country.Text
								</option>
							}
						</select>

						<span asp-validation-for="Impex._ptCountryOfOrigin"
							  class="text-danger small"></span>
					</div>

				</div>

				<!-- Column 3 -->
				<div class="col-lg-4">

					<label class="erp-label">
						Remarks
					</label>

					<textarea asp-for="Impex._ptRemarks" style="height: 115px"
							  class="form-control erp-control"
							  rows="5"
							  placeholder="Remarks"></textarea>

				</div>

			</div>

		</div>
	</div>

	<div class="mt-3">

		@if (Model.Impex != null && Model.Impex.PK_ptImpexID > 0)
		{
			<button id="btnUpdate"
					type="submit"
					class="btn btn-success px-4 shadow-sm"
					style="display:none;">
				<i class="fas fa-save me-1"></i>
				Update
			</button>

			<a asp-page="./Index"
			   class="btn btn-outline-secondary px-4">
				<i class="fas fa-times me-1"></i>
				Cancel
			</a>
		}
		else
		{
			<button id="btnAdd"
					type="submit"
					class="btn btn-primary px-4 shadow-sm">
				<i class="fas fa-plus-circle me-1"></i>
				Add New Record
			</button>
		}

	</div>	

</form>
<br />
<div class="table-responsive">

	<table id="tblImPex" class="table table-hover w-100 ">

		<thead class="sticky-top bg-white table-bordered" style="font-size:0.75rem;">
			<tr>
				<th class="text-center">No</th>
				<th>HBL No</th>				
				<th>Container No</th>
				<th>Dedon ETA</th>
				<th>Country Of Origin</th>
				<th>Remarks</th>
				<th>Created By</th>
				<th>Modified By</th>
				<th>PO No Tagged</th>
				<th class="text-center">Status</th>				
				<th class="text-center">Actions</th>
			</tr>
		</thead>

		<tbody style="font-size:0.75rem;">

			@{
				int counter = 1;
			}

			@if (Model.ImpexList != null && Model.ImpexList.Any())
			{
				foreach (var item in Model.ImpexList)
				{
					<tr>
						<td class="text-center">@counter</td>
						
						<td>@item._ptHBLNo</td>
						<td>@item._ptContainerNo</td>
						<td>@item._ptContainerETA?.ToString("yyyy-MM-dd")</td>
						<td>@item._ptCountryOfOrigin</td>
						<td class="erp-truncate">@item._ptRemarks</td>
						<td>@item._ptCreatedBy</td>
						<td>@item._ptModifiedBy</td>
						<td>
							@Html.Raw(string.Join(" ",
								Model.ProcurementList
									.Where(x => x._ptHBLNo == item._ptHBLNo && x._ptStatus != 0)
									.Select(x => $"<span class='badge bg-primary me-1'>{x._ptDocNo}</span>")))
						</td>
						<td class="text-center">
							@if (item._ptStatus == 1)
							{
								<span class="badge bg-secondary">
									<i class="fas fa-tag"></i> Tagged
								</span>


							}
							else if (item._ptStatus == 2)
							{
								<span class="badge bg-success">
									<i class="fas fa-check-circle"></i> Completed
								</span>
							}
							else
							{
								<span class="badge bg-warning text-dark">
									<i class="fas fa-clock"></i> Pending
								</span>
							}
						</td>

					

						<td class="text-center">
							@if (item._ptStatus != 2)
							{
								<a asp-page="./Index"
								   asp-route-id="@item.PK_ptImpexID"
								   class="text-secondary"
								   title="Edit HBL"
								   onclick="return confirmEdit(@item._ptStatus, '@item._ptHBLNo');">
									<i class="fa-solid fa-pen-to-square"></i>
								</a>
							}
							else
							{
								<span class="text-success" title="Locked">
									<i class="fa-solid fa-lock"></i>
								</span>
							}
						</td>
					</tr>		

					counter++;
				}
			}

		</tbody>
	</table>
</div>

@section Scripts {
	<script>
		$(function () {

			$('#countryOfOrigin').select2();

            
				const table = $('#tblImPex').DataTable({
				pageLength: 25,
				scrollX: true,
				stateSave: true,
				autoWidth: false,
				fixedHeader: true
			});

			$('.dataTables_filter input').css({
				'width': '300px',
				'min-width': '300px'
			});



				const savedSearch = sessionStorage.getItem('tblImPexSearch');

				if (savedSearch) {
					table.search(savedSearch).draw();
					$('.dataTables_filter input').val(savedSearch);
				}

				$('.dataTables_filter input').on('keyup', function () {
					sessionStorage.setItem('tblImPexSearch', this.value);
			});

		});
		function confirmEdit(status, hblNo) {

			if (status === 1) {

				const result = confirm(
					"⚠ This HBL No is already TAGGED: " + hblNo +
					"\n\nDo you want to continue editing?"
				);

				if (!result) {
					hideLoader(); // or $('#loader').hide();
				}

				return result;
			}

			return true;
		}
	</script>
}