@page
@model PlanningTool.NavExtension.Pages.ImPex.IndexModel
@{
	ViewData["Title"] = "ImPex Center";
	var activeTab = TempData["ActiveTab"]?.ToString() ?? "#impexOpen";
}
<style>
	@@keyframes pulse {
		0%, 100% {
			transform: scale(1);
		}

		50% {
			transform: scale(1.15);
		}
	}
</style>
<div class="container-fluid">
	<!-- Page Header -->
	<div class="row mb-3">
		<div class="col-md-12">
			<h3 class="fw-bold d-inline me-4">
				ImPex Center
			</h3>
			<h6 class="mb-3 text-secondary d-inline">
				<i class="fas fa-clipboard-check me-2 text-success" style="display:inline-block; animation:pulse 2s ease-in-out infinite;">

				</i> Shipment Information
			</h6>
			<hr />
		</div>
	</div>
	<div class="erp-ribbon">
		<ul class="nav nav-tabs procurement-tabs" id="impexTab" role="tablist">

			<li class="nav-item">
				<div class="ribbon-group">
					<div class="ribbon-title">STATUS</div>
					<button class="ribbon-btn @(activeTab == "#impexOpen" ? "active" : "")"
							data-bs-toggle="tab"
							data-bs-target="#impexOpen">

						<i class="fa-solid fa-box-open"></i>
						<span>Open</span>
					</button>
				</div>
			</li>

			<li class="nav-item">
				<div class="ribbon-group">
					<div class="ribbon-title">TAGGED</div>
					<button class="ribbon-btn @(activeTab == "#impexCompleted" ? "active" : "")"
							data-bs-toggle="tab"
							data-bs-target="#impexCompleted">

						<i class="fa-solid fa-circle-check"></i>
						<span>Completed</span>
					</button>
				</div>
			</li>
		</ul>

	</div>
	<div class="tab-content mt-3">
		@* ImPex Open List *@
		<div class="tab-pane fade @(activeTab == "#impexOpen" ? "show active" : "")" id="impexOpen">
			<form id="frmImpex" method="post" asp-page-handler="Save">
				<input type="hidden" asp-for="Impex.PK_ptImpexID" />
				<div class="row g-3">
					<!-- Column 1 -->
					<div class="col-lg-4">

						<div class="mb-3">
							<label class="erp-label">
								HBL No <span class="text-danger">*</span>
							</label>

							<input asp-for="Impex._ptHBLNo"
								   id="HBLNo"
								   class="form-control erp-control erp-input"
								   placeholder="HBL Number"
								   onblur="checkHblExists()"
								   required />

							<small id="hblMessage"></small>
						</div>

						<div>
							<label class="erp-label">
								DEDON ETA <span class="text-danger">*</span>
							</label>

							<input asp-for="Impex._ptContainerETA"
								   type="date"
								   class="form-control erp-control erp-input"
								   required />
						</div>

					</div>

					<!-- Column 2 -->
					<div class="col-lg-4">

						<div class="mb-3">
							<label class="erp-label">
								Container No <span class="text-danger">*</span>
							</label>

							<input asp-for="Impex._ptContainerNo"
								   class="form-control erp-control erp-input"
								   placeholder="Container Number"
								   required />
						</div>

						<div>
							<label class="erp-label">
								Country of Origin <span class="text-danger">*</span>
							</label>

							<select asp-for="Impex._ptCountryOfOrigin"
									class="form-select erp-control erp-dropdown"
									required>
								<option value="">Select Country...</option>

								@foreach (var country in Model.CountryList)
								{
									<option value="@country.Value">
										@country.Text
									</option>
								}
							</select>

							<span asp-validation-for="Impex._ptCountryOfOrigin"
								  class="text-danger small"></span>
						</div>

					</div>

					<!-- Column 3 -->
					<div class="col-lg-4">

						<label class="erp-label">
							Remarks
						</label>

						<textarea asp-for="Impex._ptRemarks" style="height: 105px"
								  class="form-control erp-control erp-textarea"
								  rows="5"
								  placeholder="Remarks">
					</textarea>

					</div>

				</div>
				<br />
				<div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

					@if (Model.Impex != null && Model.Impex.PK_ptImpexID > 0)
					{
						<button id="btnUpdate"
								type="submit"
								class="btn btn-success px-4 shadow-sm erp-btn"
								style="display:none;">
							<i class="fas fa-save me-1"></i>
							Update
						</button>

						<a asp-page="./Index"
						   class="btn btn-outline-secondary px-4 erp-btn">
							<i class="fas fa-times me-1"></i>
							Cancel
						</a>
					}
					else
					{
						<button id="btnAdd"
								type="submit"
								class="btn btn-primary px-4 shadow-sm erp-btn">
							<i class="fas fa-plus-circle me-1"></i>
							Add New Record
						</button>
					}

					<!-- ETA Legend -->
					<div class="d-flex align-items-center gap-2 small">

						<span class="fw-semibold">
							ETA Legend
						</span>

						<span class="badge bg-danger">
							<i class="fas fa-triangle-exclamation me-1"></i>
							Delayed
						</span>

						<span class="badge bg-success">
							<i class="fas fa-shipping-fast me-1"></i>
							≤ 14 Days
						</span>

						<span class="badge bg-secondary">
							<i class="fas fa-calendar-alt me-1"></i>
							&gt; 14 Days
						</span>
					</div>
				</div>
			</form>
			<div class="table-responsive">
				<br />
				<table id="tblImpexCenterOpen" class="table table-hover w-100 ">
					<thead class="sticky-top bg-white table-bordered" style="font-size:0.80rem;">
						<tr class="data-row">
							<th class="text-center">No</th>
							<th>HBL No</th>
							<th>Container No</th>
							<th>DEDON ETA</th>
							<th>Country Of Origin</th>
							<th>Remarks</th>
							<th>Created By</th>
							<th>Date Created</th>
							<th>Modified By</th>
							<th>Date Modified</th>
							@* <th>PO No Tagged</th> *@
							<th class="text-center">Status</th>
							<th class="text-center">Action</th>
						</tr>
					</thead>

					<tbody>

						@{
							int counterOpen = 1;
						}

						@if (Model.ImpexOpenList != null && Model.ImpexOpenList.Any())
						{
							foreach (var item in Model.ImpexOpenList)
							{
								<tr style="font-size: 0.8em">
									<td class="text-center">@counterOpen</td>

									<td>@item._ptHBLNo</td>
									<td>@item._ptContainerNo</td>
									<td>
										@if (item._ptContainerETA.HasValue)
										{
											<span class="eta-date"
												  data-eta="@item._ptContainerETA.Value.ToString("yyyy-MM-dd")">
												@item._ptContainerETA.Value.ToString("yyyy-MM-dd")
											</span>
										}
									</td>
									<td>@item._ptCountryOfOrigin</td>
									<td class="erp-truncate">@item._ptRemarks</td>
									<td>@item._ptCreatedBy</td>
									<td>@item._ptCreatedDate</td>
									<td>@item._ptModifiedBy</td>
									<td>@item._ptModifiedDate</td>
									<td class="text-center">
										@{
											string statusText;
											string statusIcon;
											string statusColor;

											switch (item._ptStatus)
											{
												case 1:
													statusText = "Tagged";
													statusIcon = "fa-tag";
													statusColor = "bg-primary";
													break;

												default:
													statusText = "For Tagging";
													statusIcon = "fa-clock";
													statusColor = "bg-warning";
													break;
											}
										}

										<span class="badge @statusColor text-dark status-badge">
											<i class="fas @statusIcon me-1"></i>
											@statusText
										</span>

									</td>

									<td class="text-center">
										@{
											// Bind the tagged documents for the current HBL No
											var taggedDocs = string.Join(", ",
												Model.ProcurementList
													.Where(x => x._ptHBLNo == item._ptHBLNo && x._ptStatus != 0)
													.Select(x => x._ptDocNo)
													.Distinct());
										}
										@{
											var editUrl = Url.Page("./Index", new { id = item.PK_ptImpexID });
										}

										@if (item._ptStatus != 2)
										{
											<a hrefass="text-secondary"
											   title="Edit HBL"
											   onclick="
												if (@item._ptStatus == 1) {
												if (confirm('Are you sure you want to edit this data?\n\n⚠ This HBL is already tagged with: @taggedDocs\n\nDo you want to continue?')) {
												window.location.href='@editUrl';
												}
												}
												else {
												window.location.href='@editUrl';
												}
												return false;">
												<i class="fa-solid fa-pen-to-square"></i>
											</a>
										}
										else
										{
											<span class="text-success" title="Locked">
												<i class="fa-solid fa-lock"></i>
											</span>
										}
									</td>
								</tr>

								counterOpen++;
							}
						}

					</tbody>
				</table>
			</div>
		</div>

		@* ImPex Completed List *@
		<div class="tab-pane fade @(activeTab == "#impexCompleted" ? "show active" : "")" id="impexCompleted">
			<div class="row g-3">
				<div class="col-12">
					<div class="table-responsive">
						<br />
						<table id="tblImpexCenterCompleted" class="table table-hover w-100 ">

							<thead class="sticky-top bg-white table-bordered" style="font-size:0.80rem;">
								<tr class="data-row">
									<th class="text-center">No</th>
									<th>HBL No</th>
									<th>Container No</th>
									<th>DEDON ETA</th>
									<th>Country Of Origin</th>
									<th>Remarks</th>
									<th>Created By</th>
									<th>Date Created</th>
									<th>Modified By</th>
									<th>Date Modified</th>
									<th class="text-center"> PO No Tagged</th>								

								</tr>
							</thead>

							<tbody>

								@{
									int counterCompleted = 1;
								}

								@if (Model.ImpexCompletedList != null && Model.ImpexCompletedList.Any())
								{
									foreach (var item in Model.ImpexCompletedList)
									{
										<tr style="font-size: 0.8em; vertical-align: middle;">
											<td class="text-center">@counterCompleted</td>

											<td>@item._ptHBLNo</td>
											<td>@item._ptContainerNo</td>
											<td>@item._ptContainerETA?.ToString("yyyy-MM-dd")</td>
											<td>@item._ptCountryOfOrigin</td>
											<td class="erp-truncate">@item._ptRemarks</td>
											<td>@item._ptCreatedBy</td>
											<td>@item._ptCreatedDate</td>
											<td>@item._ptModifiedBy</td>
											<td>@item._ptModifiedDate</td>

											<td class="text-center">
												@{
													var poNos = Model.ProcurementList
														.Where(p => p._ptHBLNo == item._ptHBLNo && p._ptStatus == 2)
														.Select(p => p._ptDocNo)
														.Where(po => !string.IsNullOrWhiteSpace(po))
														.Distinct()
														.ToList();
												}

												@if (poNos.Any())
												{
													<span class="d-flex flex-column gap-1">
														@foreach (var poNo in poNos)
														{
															<a href="#"
															   class="text-primary text-decoration-none">
																<span class="px-1">
																	@poNo
																</span>
															</a>
														}
													</span>
												}
												else
												{
													<span class="text-muted">—</span>
												}
											</td>

										</tr>

										counterCompleted++;
									}
								}

							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
@section Scripts {
	<script>

		let openTable;
		let completeTable;

		/* ==============================
		   Utilities
		============================== */

		function getTableHeight() {
			return `${$(window).height() * 0.6}px`;
		}

		/* ==============================
		   DataTables
		============================== */

		function createDataTable(selector, filename) {

			return $(selector).DataTable({
				pageLength: 25,
				paging: false,
				scrollX: true,
				scrollY: getTableHeight(),
				scrollCollapse: true,
				autoWidth: false,
				fixedHeader: false,
				responsive: false,

				dom: 'Bfrtip',

				buttons: [{
					extend: 'excelHtml5',
					text: '<i class="fas fa-file-excel"></i> Export Excel',
					className: 'btn btn-sm erp-btn',
					title: null,
					filename,

					exportOptions: {
						columns: ':visible:not(.no-export)',
						modifier: {
							search: 'applied',
							order: 'applied'
						}
					},

					action: function (e, dt, button, config) {

						const fileName = `${config.filename}.xlsx`;

						const message =
							`Export data to Excel?\n\n` +
							`File:\n${fileName}\n\n` +
							`The save location is controlled by your browser settings.`;

						if (confirm(message)) {

							$.fn.dataTable.ext.buttons.excelHtml5.action.call(
								this,
								e,
								dt,
								button,
								config
							);
						}
					}
				}]
			});
		}

		/* ==============================
		   Column Filter
		============================== */

		function addColumnFilter(table, tableId) {

			const $filter = $(`${tableId}_filter`);
			const $searchInput = $filter.find('input');
			const $columnFilter = $('<select class="columnFilter"></select>');

			$filter.find('label')
				.contents()
				.filter((_, node) => node.nodeType === 3)
				.remove();

			$searchInput.attr('placeholder', 'Type to filter (F3)');

			table.columns().every(function (index) {

				const title = $(this.header()).text().trim();

				if (title) {
					$columnFilter.append(
						`<option value="${index}">${title}</option>`
					);
				}
			});

			$searchInput.after($columnFilter);

			const filterData = () => {

				table.columns().search('');

				table
					.column(Number($columnFilter.val()))
					.search($searchInput.val())
					.draw();
			};

			$searchInput.on('input', filterData);
			$columnFilter.on('change', filterData);

			// Move Export Button
			const $buttons = $(`${tableId}_wrapper .dt-buttons`);
			$columnFilter.after($buttons);
		}

		/* ==============================
		   HBL Validation
		============================== */

		async function checkHblExists() {

			const hblNo = $('#HBLNo').val().trim();
			const $btnAdd = $('#btnAdd');
			const $msg = $('#hblMessage');

			if (!hblNo) {
				$msg.empty();
				$btnAdd.prop('disabled', false);
				return;
			}

			try {

				const response = await fetch(
					`?handler=CheckHbl&hblNo=${encodeURIComponent(hblNo)}`
				);

				const exists = await response.json();

				$msg
					.text(
						exists
							? '⚠ HBL No already exists.'
							: '✓ HBL No available.'
					)
					.css('color', exists ? 'red' : 'green');

				$btnAdd.prop('disabled', exists);

			} catch (error) {

				console.error(error);

				$msg
					.text('Unable to validate HBL No.')
					.css('color', 'red');
			}
		}

		/* ==============================
		   ETA Color Formatting
		============================== */

		function applyEtaColors() {

			$('.eta-date').each(function () {

				const etaValue = $(this).data('eta');

				if (!etaValue) return;

				const etaDate = new Date(etaValue);
				const today = new Date();

				today.setHours(0, 0, 0, 0);
				etaDate.setHours(0, 0, 0, 0);

				const days = Math.ceil((etaDate - today) / 86400000);

				const color =
					days <= -7 ? '#b02a37' : // Delayed 7+ days
					days <= 14 ? '#198754' : // <= 14 days
									'#6c757d';  // > 14 days

				$(this).css({
					backgroundColor: color,
					color: '#fff',
					padding: '3px 8px',
					borderRadius: '4px',
					fontWeight: '600',
					fontSize: '0.8em',
					display: 'inline-block'
				});

			});
		}

		/* ==============================
		   Page Load
		============================== */

		$(document).ready(function () {

			const today = new Date().toISOString().split('T')[0];

			// Select2
			$('#countryOfOrigin').select2();

			// If exists
			if ($('#impexDropdown').length) {
				$('#impexDropdown').select2();
			}

			// DataTables
			openTable = createDataTable(
				'#tblImpexCenterOpen',
				`ImPex_Open_List_${today}`
			);

			completeTable = createDataTable(
				'#tblImpexCenterCompleted',
				`ImPex_Completed_List_${today}`
			);

			addColumnFilter(
				openTable,
				'#tblImpexCenterOpen'
			);

			addColumnFilter(
				completeTable,
				'#tblImpexCenterCompleted'
			);

			// Fix header alignment
			setTimeout(() => {
				openTable.columns.adjust();
				completeTable.columns.adjust();
			}, 300);

			$(window).on('resize', function () {

				$.fn.dataTable
					.tables({ visible: true, api: true })
					.columns.adjust();
			});

			// Track Changes
			const originalData = $('#frmImpex').serialize();

			$('#frmImpex').on(
				'input change',
				'input, select, textarea',
				function () {

					const changed =
						$('#frmImpex').serialize() !== originalData;

					$('#btnUpdate').toggle(changed);
				}
			);

			// HBL Validation
			$('#HBLNo').on('blur', checkHblExists);

			// ETA Colors
			applyEtaColors();

			$('button[data-bs-toggle="tab"]').on('shown.bs.tab', function () {

				$.fn.dataTable
					.tables({ visible: true, api: true })
					.columns.adjust();
			});			
			
		});		

	</script>
}