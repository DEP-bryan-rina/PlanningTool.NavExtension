@page
@model PlanningTool.NavExtension.Pages.QA.IndexModel

@{
    ViewData["Title"] = "QA Dashboard";
}

<style>
    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.15);
        }
    }

    .qa-mrp-row {
        cursor: pointer;
    }

    #tblMRPDetails tfoot {
        background-color: #f8f9fa;
        font-weight: 700;
    }
</style>


<div class="container-fluid">

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->
    <div class="row mb-3">
        <div class="col-md-12">

            <h3 class="fw-bold">
                <i class="fas fa-tachometer-alt text-success"></i>
                Raw Material Quality Inspection Dashboard
            </h3>

            <h6 class="mb-3 text-secondary">
                <i class="fas fa-clipboard-check me-2 text-success"
                   style="display:inline-block; animation:pulse 2s ease-in-out infinite;">
                </i>
                Quality Monitoring & Analytics
            </h6>

            <hr />

        </div>
    </div>


    <!-- =====================================================
         KPI CARDS
    ====================================================== -->
    <div class="row mb-4">

        <!-- Defect Rate -->
        <div class="col-md-3 mb-3">
            <div class="card qa-card h-100">
                <div class="card-body d-flex align-items-center">

                    <i class="bi bi-exclamation-triangle text-danger fs-1 me-3"></i>

                    <a asp-page="/QA/Vendors"
                       class="text-decoration-none text-black">

                        <div class="kpi-card">

                            <div class="kpi-value text-danger">
                                @Model.DefectRate%
                            </div>

                            <div class="kpi-label" title="Percentage of items with Reject or Repair disposition">
                                Defect Rate
                            </div>

                        </div>

                    </a>

                </div>
            </div>
        </div>


        <!-- Completion -->
        <div class="col-md-3 mb-3">
            <div class="card qa-card h-100">
                <div class="card-body d-flex align-items-center">

                    <i class="bi bi-stopwatch text-success fs-1 me-3"></i>

                    <div>

                        <div class="kpi-value text-success">
                            @Model.Completion%
                        </div>

                        <div class="kpi-label" title="Percentage of received quantity already inspected">                            
                            Inspection Completion
                        </div>

                    </div>

                </div>
            </div>
        </div>


        <!-- Quality Rating -->
        <div class="col-md-3 mb-3">
            <div class="card qa-card h-100">
                <div class="card-body d-flex align-items-center">

                    <i class="bi bi-clipboard2-check text-primary fs-1 me-3"></i>

                    <div>

                        <div class="kpi-value text-primary">
                            @Model.QualityRating%
                        </div>

                        <div class="kpi-label" title="Percentage of received quantity that passed QA">
                            Quality Rating
                        </div>

                    </div>

                </div>
            </div>
        </div>


        <!-- Lead Time -->
        <div class="col-md-3 mb-3">
            <div class="card qa-card h-100">
                <div class="card-body d-flex align-items-center">

                    <i class="bi bi-calendar-check text-warning fs-1 me-3"></i>

                    <div>

                        <div class="kpi-value text-warning">
                            @Model.LeadTime
                        </div>

                        <div class="kpi-label" title="Average number of days from receipt until QA completion">
                            Average Lead Time (Days)
                        </div>

                    </div>

                </div>
            </div>
        </div>

    </div>


    <!-- =====================================================
         QA DASHBOARD TABLE
    ====================================================== -->
    <div class="table-responsive qa-table-container">

        <table id="tblQA"
               class="table table-hover w-100">

            <thead class="sticky-top bg-white table-bordered"
                   style="font-size:0.75rem;">

                <tr>
                    <th>Item Code</th>
                    <th>Description</th>
                    <th>Date Received</th>
                    <th>Date QA Start</th>
                    <th>UoM</th>
                    <th class="text-center">Qty Received</th>
                    <th class="text-center">Status</th>
                    <th class="text-center">Qty Good</th>
                    <th class="text-center">Qty Rejected</th>
                    <th class="text-center">Qty For Repair</th>
                    <th class="text-center">MRP For Repair</th>
                    <th class="text-center">MRP Latest WK Required</th>
                    <th class="text-center">Lead Time (Days)</th>
                </tr>

            </thead>

            <tbody style="font-size:0.75rem;">

                @if (Model.Items?.Any() == true)
                {
                    foreach (var item in Model.Items)
                    {
                        var statusClass = item.Status switch
                        {
                            "COMPLETED" => "status-completed",
                            "WIP" => "status-wip",
                            "NS" => "status-ns",
                            "MRP" => "status-mrp",
                            _ => "status-na"
                        };

                        var hasMRPRepair =
                            item.AllocationForRepair > 0;

                        var rowClass =
                            hasMRPRepair
                                ? "qa-mrp-row"
                                : string.Empty;

                        var rowTitle =
                            hasMRPRepair
                                ? "Click to view MRP repair details"
                                : string.Empty;

                        <tr class="@rowClass"
                            data-item-code="@item.ItemCode"
                            title="@rowTitle">

                            <!-- Item Code -->
                            <td>
                                <strong>
                                    @item.ItemCode
                                </strong>
                            </td>

                            <!-- Description -->
                            <td>
                                @item.Description
                            </td>

                            <!-- Date Received -->
                            <td>
                                @if (item.DateReceived.HasValue)
                                {
                                    @item.DateReceived.Value.ToString("yyyy-MM-dd")
                                }
                            </td>
                            <!-- Date QA Start -->
                            <td>
                                @if (item.DateQAStart.HasValue)
                                {
                                    @item.DateQAStart.Value.ToString("yyyy-MM-dd")
                                }
                            </td>

                            <!-- UOM -->
                            <td>
                                @item.UOM
                            </td>

                            <!-- Qty Received -->
                            <td class="text-center">
                                @item.QtyReceived.ToString("N0")
                            </td>

                            <!-- Status -->
                            <td class="text-center @statusClass">
                                @item.Status
                            </td>

                            <!-- Qty Good -->
                            <td class="text-center">
                                @item.QtyGood.ToString("N0")
                            </td>

                            <!-- Qty Reject -->
                            <td class="text-center">

                                @if (item.QtyReject > 0)
                                {
                                    <span class="badge bg-danger">
                                        @item.QtyReject.ToString("N0")
                                    </span>
                                }
                                else
                                {
                                    @item.QtyReject.ToString("N0")
                                }

                            </td>

                            <!-- Qty Repair -->
                            <td class="text-center">

                                @if (item.QtyRepair > 0)
                                {
                                    <span class="badge bg-primary">
                                        @item.QtyRepair.ToString("N0")
                                    </span>
                                }
                                else
                                {
                                    @item.QtyRepair.ToString("N0")
                                }

                            </td>

                            <!-- MRP For Repair -->
                            <td class="text-center">

                                @if (item.AllocationForRepair > 0)
                                {
                                    <span class="badge bg-warning text-dark">
                                        @item.AllocationForRepair.ToString("N0")
                                    </span>
                                }
                                else
                                {
                                    @item.AllocationForRepair.ToString("N0")
                                }

                            </td>

                            <!-- Repair Week Required -->
                            <td class="text-center">
                                @item.RepairWKRequired
                            </td>

                            <!-- Lead Time -->
                            <td class="text-center"
                                style="width:100px;">

                                @if (item.LeadTimeDays > 0)
                                {
                                    @item.LeadTimeDays
                                }

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

</div>


<!-- =========================================================
     MRP REPAIR DETAIL MODAL
========================================================== -->
<div class="modal fade"
     id="mrpRepairModal"
     tabindex="-1"
     aria-labelledby="mrpRepairModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">

        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">

                <h5 class="modal-title"
                    id="mrpRepairModalLabel">

                    <i class="fas fa-tools text-primary me-2"></i>
                    MRP Repair Requirement

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- Modal Body -->
            <div class="modal-body">

                <!-- Selected Item -->
                <div class="mb-3">

                    <span class="text-secondary">
                        Item Code:
                    </span>

                    <strong id="mrpItemCode"
                            class="text-primary ms-1">
                    </strong>

                </div>


                <!-- MRP Detail Table -->
                <div class="table-responsive">

                    <table id="tblMRPDetails"
                           class="table table-sm table-hover table-bordered mb-0">

                        <thead class="table-light"
                               style="font-size:0.75rem;">

                            <tr>
                                <th>Sales Order No.</th>
                                <th>Customer No.</th>
                                <th>Shipment Date</th>
                                <th>WK Required</th>
                                <th style="text-align:center">Status</th>
                                <th style="text-align:right">Quantity</th>
                                <th>Sales Product Code</th>
                                <th>Child Item No.</th>
                                <th style="text-align:right">QA Rework Allocation</th>
                            </tr>

                        </thead>

                        <tbody id="mrpDetailBody"
                               style="font-size:0.75rem;">
                        </tbody>

                        <tfoot class="table-light"
                               style="font-size:0.75rem;">

                            <tr>

                                <td colspan="5"
                                    class="text-end fw-bold">
                                    TOTAL:
                                </td>

                                <td id="mrpTotalQuantity"
                                    class="text-end fw-bold">
                                    0
                                </td>

                                <td colspan="2"
                                    class="text-end fw-bold">
                                    TOTAL QA REWORK:
                                </td>

                                <td id="mrpTotalAllocation"
                                    class="text-end fw-bold text-primary">
                                    0
                                </td>

                            </tr>

                        </tfoot>

                    </table>

                </div>

            </div>


            <!-- Modal Footer -->
            <div class="modal-footer">

                <!-- Export Excel -->
                <button type="button"
                        id="btnExportMRPExcel"
                        class="btn btn-success erp-btn"
                        disabled>

                    <i class="fas fa-file-excel me-1"></i>
                    Export Excel

                </button>

                <!-- Close -->
                <button type="button"
                        class="btn btn-primary erp-btn"
                        data-bs-dismiss="modal">

                    <i class="fas fa-times me-1 text-danger"></i>
                    Cancel

                </button>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <script>

        /* =====================================================
           MRP EXPORT DATA
        ====================================================== */

        let currentMRPDetails = [];


        /* =====================================================
           GENERAL UTILITIES
        ====================================================== */

        function escapeHtml(value) {

            return $('<div>')
                .text(value ?? '')
                .html();
        }


        function formatMRPDate(value) {

            if (!value) {
                return '';
            }

            const date = new Date(value);

            if (isNaN(date.getTime())) {
                return '';
            }

            return date
                .toISOString()
                .split('T')[0];
        }


        function formatMRPNumber(value) {

            const number =
                Number(value || 0);

            return number.toLocaleString(
                undefined,
                {
                    minimumFractionDigits: 0,
                    maximumFractionDigits: 2
                }
            );
        }


        function getTableHeight() {

            return `${$(window).height() * 0.6}px`;
        }


        /* =====================================================
           RESET MRP TOTALS
        ====================================================== */

        function resetMRPTotals() {

            $('#mrpTotalQuantity')
                .text('0');

            $('#mrpTotalAllocation')
                .text('0');
        }


        /* =====================================================
           DISPLAY MRP MESSAGE
        ====================================================== */

        function showMRPMessage(
            message,
            cssClass
        ) {

            $('#mrpDetailBody').html(`
                <tr>
                    <td colspan="9"
                        class="text-center ${cssClass} py-4">
                        ${escapeHtml(message)}
                    </td>
                </tr>
            `);
        }


        /* =====================================================
   EXPORT MRP DETAILS TO EXCEL
====================================================== */

function exportMRPDetailsToExcel() {

    /* -------------------------------------------------
       CHECK DATA
    -------------------------------------------------- */

    if (
        !currentMRPDetails ||
        currentMRPDetails.length === 0
    ) {

        alert(
            'There are no MRP repair details to export.'
        );

        return;
    }


    /* -------------------------------------------------
       SELECTED ITEM
    -------------------------------------------------- */

    const itemCode =
        $('#mrpItemCode')
            .text()
            .trim() || 'MRP';


    /* -------------------------------------------------
       REPORT DATE
    -------------------------------------------------- */

    const today =
        new Date()
            .toISOString()
            .split('T')[0];


    /* -------------------------------------------------
       FILE NAME
    -------------------------------------------------- */

    const fileName =
        `MRP_Repair_${itemCode}_${today}.xlsx`;


    /* -------------------------------------------------
       EXPORT CONFIRMATION
    -------------------------------------------------- */

    const confirmMessage =
        `Export MRP Repair Details to Excel?\n\n` +
        `Item Code: ${itemCode}\n` +
        `Records: ${currentMRPDetails.length}\n\n` +
        `File:\n${fileName}\n\n` +
        `The save location is controlled by your browser settings.`;


    if (!confirm(confirmMessage)) {
        return;
    }


    /* -------------------------------------------------
       TOTAL VARIABLES
    -------------------------------------------------- */

    let totalQuantity = 0;
    let totalAllocation = 0;


    /* -------------------------------------------------
       CREATE TEMPORARY EXPORT TABLE
    -------------------------------------------------- */

    const $exportTable = $(`
        <table>

            <thead>
                 <tr>
                    <th>Sales Order No.</th>
                    <th>Customer No.</th>
                    <th>Shipment Date</th>
                    <th>WK Required</th>
                    <th>Status</th>
                    <th>Quantity</th>
                    <th>Sales Product Code</th>
                    <th>Child Item No.</th>
                    <th>QA Rework Allocation</th>
                </tr>
            </thead>

            <tbody>
            </tbody>

        </table>
    `);


    const $exportBody =
        $exportTable.find('tbody');


    /* -------------------------------------------------
       BUILD EXPORT ROWS
    -------------------------------------------------- */

    currentMRPDetails.forEach(
        function (row) {

            const quantity =
                Number(
                    row.quantity || 0
                );

            const allocation =
                Number(
                    row.allocationForRepair || 0
                );


            totalQuantity +=
                quantity;

            totalAllocation +=
                allocation;


            const $row =
                $('<tr>');


            $row.append(
                $('<td>').text(
                    row.salesOrderNo ?? ''
                )
            );


            $row.append(
                $('<td>').text(
                    row.customerNo ?? ''
                )
            );


            $row.append(
                $('<td>').text(
                    formatMRPDate(
                        row.shipmentDate
                    )
                )
            );

            $row.append(
                $('<td>').text(
                    row.requiredWeek ?? ''
                )
            );

            $row.append(
                $('<td>').text(
                    row.status ?? ''
                )
            );

            $row.append(
                $('<td>').text(
                    quantity
                )
            );


            $row.append(
                $('<td>').text(
                    row.salesProductCode ?? ''
                )
            );


            $row.append(
                $('<td>').text(
                    row.itemCode ?? ''
                )
            );


            $row.append(
                $('<td>').text(
                    allocation
                )
            );


            $exportBody.append(
                $row
            );

        }
    );


    /* -------------------------------------------------
       TOTAL ROW
    -------------------------------------------------- */

    const $totalRow =
        $('<tr>');


    $totalRow.append(
        $('<td>').text('TOTAL')
    );


    $totalRow.append(
        $('<td>').text('')
    );


    $totalRow.append(
        $('<td>').text('')
    );


    $totalRow.append(
        $('<td>').text(
            totalQuantity
        )
    );


    $totalRow.append(
        $('<td>').text('')
    );


    $totalRow.append(
        $('<td>').text(
            'TOTAL QA REWORK'
        )
    );


    $totalRow.append(
        $('<td>').text(
            totalAllocation
        )
    );


    $exportBody.append(
        $totalRow
    );


    /* -------------------------------------------------
       ADD TEMPORARY TABLE
    -------------------------------------------------- */

    $exportTable.css({
        position: 'absolute',
        left: '-9999px',
        top: '-9999px'
    });


    $('body').append(
        $exportTable
    );


    /* -------------------------------------------------
       CREATE TEMPORARY DATATABLE
    -------------------------------------------------- */

    const exportDataTable =
        $exportTable.DataTable({

            paging:
                false,

            searching:
                false,

            ordering:
                false,

            info:
                false,

            dom:
                'B',

            buttons: [
                {
                    extend:
                        'excelHtml5',

                    title:
                        `MRP Repair Requirement - ${itemCode}`,

                    filename:
                        `MRP_Repair_${itemCode}_${today}`,

                    exportOptions: {
                        columns:
                            ':visible'
                    }
                }
            ]

        });


    /* -------------------------------------------------
       EXPORT EXCEL
    -------------------------------------------------- */

    exportDataTable
        .button(0)
        .trigger();


    /* -------------------------------------------------
       CLEAN TEMPORARY TABLE
    -------------------------------------------------- */

    setTimeout(
        function () {

            exportDataTable.destroy();

            $exportTable.remove();

        },
        500
    );
}


        /* =====================================================
           LOAD MRP REPAIR DETAILS
        ====================================================== */

        function loadMRPRepairDetails(itemCode) {

            const modalElement =
                document.getElementById(
                    'mrpRepairModal'
                );


            const modal =
                bootstrap.Modal.getOrCreateInstance(
                    modalElement
                );


            const $body =
                $('#mrpDetailBody');


            /* -------------------------------------------------
               RESET EXPORT
            -------------------------------------------------- */

            currentMRPDetails = [];

            $('#btnExportMRPExcel')
                .prop(
                    'disabled',
                    true
                );


            /* -------------------------------------------------
               SELECTED ITEM
            -------------------------------------------------- */

            $('#mrpItemCode')
                .text(itemCode);


            /* -------------------------------------------------
               RESET TOTALS
            -------------------------------------------------- */

            resetMRPTotals();


            /* -------------------------------------------------
               LOADING
            -------------------------------------------------- */

            $body.html(`
                <tr>

                    <td colspan="9"
                        class="text-center text-secondary py-4">

                        <span class="spinner-border spinner-border-sm me-2">
                        </span>

                        Loading MRP details...

                    </td>

                </tr>
            `);


            /* -------------------------------------------------
               SHOW MODAL
            -------------------------------------------------- */

            modal.show();


            /* -------------------------------------------------
               AJAX
            -------------------------------------------------- */

            $.ajax({

                url:
                    '@Url.Page("/QA/Index", "RepairMRP")',

                type:
                    'GET',

                data: {
                    itemCode: itemCode
                },


                /* =============================================
                   SUCCESS
                ============================================== */

                success: function (result) {

                    $body.empty();

                    resetMRPTotals();


                    /* -----------------------------------------
                       REQUEST FAILED
                    ------------------------------------------ */

                    if (!result.success) {

                        currentMRPDetails = [];

                        $('#btnExportMRPExcel')
                            .prop(
                                'disabled',
                                true
                            );

                        showMRPMessage(
                            result.message ||
                            'Unable to load MRP details.',
                            'text-danger'
                        );

                        return;
                    }


                    /* -----------------------------------------
                       NO RECORDS
                    ------------------------------------------ */

                    if (
                        !result.data ||
                        result.data.length === 0
                    ) {

                        currentMRPDetails = [];

                        $('#btnExportMRPExcel')
                            .prop(
                                'disabled',
                                true
                            );

                        showMRPMessage(
                            'No MRP repair details found.',
                            'text-secondary'
                        );

                        return;
                    }


                    /* -----------------------------------------
                       SAVE EXPORT DATA
                    ------------------------------------------ */

                    currentMRPDetails =
                        result.data;


                    $('#btnExportMRPExcel')
                        .prop(
                            'disabled',
                            false
                        );


                    /* -----------------------------------------
                       TOTALS
                    ------------------------------------------ */

                    let totalQuantity = 0;
                    let totalAllocation = 0;


                    /* -----------------------------------------
                       BUILD DETAIL ROWS
                    ------------------------------------------ */

                    result.data.forEach(
                        function (row) {

                            const quantity =
                                Number(
                                    row.quantity || 0
                                );

                            const allocation =
                                Number(
                                    row.allocationForRepair || 0
                                );


                            totalQuantity +=
                                quantity;

                            totalAllocation +=
                                allocation;


                            $body.append(`
                                <tr>

                                    <td>
                                        ${escapeHtml(
                                            row.salesOrderNo
                                        )}
                                    </td>

                                    <td>
                                        ${escapeHtml(
                                            row.customerNo
                                        )}
                                    </td>

                                    <td>
                                        ${formatMRPDate(
                                            row.shipmentDate
                                        )}
                                    </td>

                                    <td>
                                        ${escapeHtml(
                                                            row.requiredWeek
                                        )}
                                    </td>

                                    <td class="text-center">
                                        ${row.status === 'RELEASED'
                                            ? '<span class="badge bg-success">RELEASED</span>'
                                            : '<span class="badge bg-warning text-dark">OPEN</span>'
                                        }
                                    </td>

                                    <td class="text-end">
                                        ${formatMRPNumber(
                                            quantity
                                        )}
                                    </td>

                                    <td>
                                        ${escapeHtml(
                                            row.salesProductCode
                                        )}
                                    </td>

                                    <td>
                                        ${escapeHtml(
                                            row.itemCode
                                        )}
                                    </td>

                                    <td class="text-end fw-bold text-primary">
                                        ${formatMRPNumber(
                                            allocation
                                        )}
                                    </td>

                                </tr>
                            `);

                        }
                    );


                    /* -----------------------------------------
                       DISPLAY TOTALS
                    ------------------------------------------ */

                    $('#mrpTotalQuantity')
                        .text(
                            formatMRPNumber(
                                totalQuantity
                            )
                        );


                    $('#mrpTotalAllocation')
                        .text(
                            formatMRPNumber(
                                totalAllocation
                            )
                        );
                },


                /* =============================================
                   ERROR
                ============================================== */

                error: function (xhr) {

                    let message =
                        'Unable to load MRP repair details.';


                    if (
                        xhr.responseJSON &&
                        xhr.responseJSON.message
                    ) {

                        message =
                            xhr.responseJSON.message;
                    }


                    currentMRPDetails = [];


                    $('#btnExportMRPExcel')
                        .prop(
                            'disabled',
                            true
                        );


                    resetMRPTotals();


                    showMRPMessage(
                        message,
                        'text-danger'
                    );
                }

            });
        }


        /* =====================================================
           MAIN DATATABLE
        ====================================================== */

        function createDataTable(
            selector,
            filename
        ) {

            return $(selector).DataTable({

                pageLength:
                    25,

                paging:
                    false,

                order: [[12, 'desc']], // Lead Time column

                scrollX:
                    true,

                scrollY:
                    getTableHeight(),

                scrollCollapse:
                    true,

                autoWidth:
                    false,

                fixedHeader:
                    false,

                responsive:
                    false,


                language: {

                    emptyTable:
                        'No records found.'

                },


                dom:
                    'Bfrtip',


                buttons: [
                    {
                        extend:
                            'excelHtml5',

                        text:
                            '<i class="fas fa-file-excel"></i> Export Excel',

                        className:
                            'btn btn-sm erp-btn',

                        title:
                            null,

                        filename:
                            filename,

                        exportOptions: {

                            columns:
                                ':visible:not(.no-export)',

                            modifier: {

                                search:
                                    'applied',

                                order:
                                    'applied'

                            }

                        },


                        action: function (
                            e,
                            dt,
                            button,
                            config
                        ) {

                            const fileName =
                                `${config.filename}.xlsx`;


                            const message =
                                `Export data to Excel?\n\n` +
                                `File:\n${fileName}\n\n` +
                                `The save location is controlled by your browser settings.`;


                            if (!confirm(message)) {
                                return;
                            }


                            $.fn.dataTable
                                .ext
                                .buttons
                                .excelHtml5
                                .action
                                .call(
                                    this,
                                    e,
                                    dt,
                                    button,
                                    config
                                );
                        }
                    }
                ]
            });
        }


        /* =====================================================
           COLUMN FILTER
        ====================================================== */

        function addColumnFilter(
            table,
            tableId
        ) {

            const $filter =
                $(`${tableId}_filter`);


            const $searchInput =
                $filter.find(
                    'input'
                );


            const $columnFilter =
                $(
                    '<select class="columnFilter"></select>'
                );


            /* -------------------------------------------------
               REMOVE DEFAULT SEARCH LABEL
            -------------------------------------------------- */

            $filter
                .find('label')
                .contents()
                .filter(
                    (_, node) =>
                        node.nodeType === 3
                )
                .remove();


            /* -------------------------------------------------
               SEARCH PLACEHOLDER
            -------------------------------------------------- */

            $searchInput.attr(
                'placeholder',
                'Type to filter (F3)'
            );


            /* -------------------------------------------------
               COLUMN OPTIONS
            -------------------------------------------------- */

            table.columns().every(
                function (index) {

                    const title =
                        $(this.header())
                            .text()
                            .trim();


                    if (!title) {
                        return;
                    }


                    $columnFilter.append(
                        $('<option>', {

                            value:
                                index,

                            text:
                                title
                        })
                    );
                }
            );


            /* -------------------------------------------------
               ADD FILTER
            -------------------------------------------------- */

            $searchInput.after(
                $columnFilter
            );


            /* -------------------------------------------------
               FILTER DATA
            -------------------------------------------------- */

            function filterData() {

                const columnIndex =
                    Number(
                        $columnFilter.val()
                    );


                table
                    .columns()
                    .search('');


                table
                    .column(
                        columnIndex
                    )
                    .search(
                        $searchInput.val()
                    )
                    .draw();
            }


            /* -------------------------------------------------
               FILTER EVENTS
            -------------------------------------------------- */

            $searchInput.on(
                'input',
                filterData
            );


            $columnFilter.on(
                'change',
                filterData
            );


            /* -------------------------------------------------
               MOVE EXPORT BUTTON
            -------------------------------------------------- */

            const $buttons =
                $(
                    `${tableId}_wrapper .dt-buttons`
                );


            $columnFilter.after(
                $buttons
            );
        }


        /* =====================================================
           PAGE LOAD
        ====================================================== */

        $(function () {


            /* -------------------------------------------------
               MRP EXPORT EXCEL
            -------------------------------------------------- */

            $(document).on(
                'click',
                '#btnExportMRPExcel',
                function () {

                    exportMRPDetailsToExcel();

                }
            );


            /* -------------------------------------------------
               MRP ROW CLICK
            -------------------------------------------------- */

            $(document).on(
                'click',
                '#tblQA tbody tr.qa-mrp-row',
                function () {

                    const itemCode =
                        $(this)
                            .data(
                                'item-code'
                            );


                    if (!itemCode) {
                        return;
                    }


                    loadMRPRepairDetails(
                        itemCode
                    );
                }
            );


            /* -------------------------------------------------
               REPORT DATE
            -------------------------------------------------- */

            const today =
                new Date()
                    .toISOString()
                    .split('T')[0];


            /* -------------------------------------------------
               INITIALIZE QA DATATABLE
            -------------------------------------------------- */

            const taggedTable =
                createDataTable(
                    '#tblQA',
                    `QA_Dashboard_Report_${today}`
                );


            /* -------------------------------------------------
               COLUMN FILTER
            -------------------------------------------------- */

            addColumnFilter(
                taggedTable,
                '#tblQA'
            );


            /* -------------------------------------------------
               DUPLICATE COLOR LOGIC
            -------------------------------------------------- */

            if (
                typeof colorDuplicateHBL ===
                'function'
            ) {

                colorDuplicateHBL();


                taggedTable.on(
                    'draw',
                    colorDuplicateHBL
                );
            }


            /* -------------------------------------------------
               WINDOW RESIZE
            -------------------------------------------------- */

            $(window).on(
                'resize',
                function () {

                    $.fn.dataTable
                        .tables({
                            visible:
                                true,

                            api:
                                true
                        })
                        .columns
                        .adjust();
                }
            );

        });

    </script>
}
