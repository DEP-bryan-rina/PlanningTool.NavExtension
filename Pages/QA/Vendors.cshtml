@page
@model PlanningTool.NavExtension.Pages.QA.VendorsModel
@{
	ViewData["Title"] = "Vendor Quality Performance";
}
<style>
	@@keyframes pulse {
		0%, 100% {
			transform: scale(1);
		}

		50% {
			transform: scale(1.15);
		}
	}

	.qa-report {
		font-family: Arial;
		padding: 20px;
	}


	.summary {
		font-size: 18px;
		line-height: 30px;
	}


	.defect {
		color: #d93025;
	}



	.charts {
		display: flex;
		gap: 20px;
	}


	.chart-box {
		width: 50%;
		border: 1px solid #ddd;
		padding: 20px;
		cursor: pointer;
	}


		.chart-box:hover {
			background: #f7f7f7;
		}


	canvas {
		height: 350px !important;
	}

	.vendor-table-scroll {
		max-height: 430px;
		overflow-y: auto;
		overflow-x: auto;
	}


		.vendor-table-scroll thead th {
			position: sticky;
			top: 0;
			z-index: 10;
			background: white;
			border-bottom: 2px solid #dee2e6;
		}


		.vendor-table-scroll table {
			margin-bottom: 0;
        }

    .card {
        border: none;
        border-radius: 12px;
    }

    .card-header {
        background: #fff;
        font-weight: 600;
    }

    #tblVendorsCalculation th {
        white-space: nowrap;
    }

    canvas {
        height: 600px !important;
    }
</style>
<div class="container-fluid">
	<!-- Page Header -->

    <div class="col-md-12">

        <div class="d-flex justify-content-between align-items-start">

            <!-- Title -->
            <div>
                <h3 class="fw-bold">
                    <i class="fas fa-chart-line text-success"></i>
                    Vendor Quality Performance
                </h3>

                <h6 class="mb-3 text-secondary">
                    <i class="fas fa-clipboard-check me-2 text-success"
                       style="display:inline-block; animation:pulse 2s ease-in-out infinite;">
                    </i>
                    Raw Materials & Vendor Quality Performance Report
                </h6>
            </div>

            <!-- Back Button -->
            <div>
                <a asp-page="/QA/Index"
                   class="btn btn-sm btn-outline-secondary"
                   title="Back to QA Dashboard">
                    <i class="fas fa-arrow-left me-1"></i>
                    Back
                </a>
            </div>

        </div>

        <hr />

    </div>

	<div class="accordion" id="vendorsKPI">
		<div class="accordion-item">
			<h2 class="accordion-header" id="headingVendorKPI">
				<button class="accordion-button py-2 px-3 small btn-sm"
						type="button"
						data-bs-toggle="collapse"
						data-bs-target="#collapseVendorKPI"
						aria-expanded="true"
						aria-controls="collapseVendorKPI">
					Vendors KPI
				</button>
			</h2>

			<div id="collapseVendorKPI"
                 class="accordion-collapse collapse show"
                 aria-labelledby="headingVendorKPI"
                 data-bs-parent="#vendorsKPI">

				<div class="accordion-body">
                    <!-- KPI SUMMARY -->
                    <div class="row mb-4">

                        <div class="col-md-3">
                            <div class="card border-start border-primary border-5 shadow-sm">
                                <div class="card-body">
                                    <small class="text-muted">Total Vendors</small>
                                    <h3 class="mb-0 text-primary">
                                        @(Model.VendorReport?.Count() ?? 0)
                                    </h3>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="card border-start border-success border-5 shadow-sm">
                                <div class="card-body">
                                    <small class="text-muted">Qty Received</small>
                                    <h3 class="mb-0 text-success">
                                        @(Model.VendorReport?.Sum(x => x.QtyReceived).ToString("N0"))
                                    </h3>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="card border-start border-danger border-5 shadow-sm">
                                <div class="card-body">
                                    <small class="text-muted">Defective Qty</small>
                                    <h3 class="mb-0 text-danger">
                                        @(Model.VendorReport?.Sum(x => x.QtyReject + x.QtyRepair).ToString("N0"))
                                    </h3>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="card border-start border-warning border-5 shadow-sm">
                                <div class="card-body">
                                    <small class="text-muted">Average Defect Rate</small>
                                    <h3 class="mb-0 text-warning">
                                        @(Model.VendorReport != null && Model.VendorReport.Any()
                                            ? Model.VendorReport.Average(x => x.DefectRate).ToString("N2")
                                            : "0.00")%
                                    </h3>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <!-- CHART -->
                        <div class="col-lg-4 mb-3">

                            <div class="card shadow-sm h-100">

                                <div class="card-header fw-bold">
                                    <i class="fas fa-chart-bar text-primary me-2"></i>
                                    Vendor Defect Rate
                                </div>

                                <div class="card-body">
                                    <canvas id="chartMonth"></canvas>
                                </div>

                            </div>

                        </div>

                        <!-- KPI TABLE -->
                        <div class="col-lg-8 mb-3">

                            <div class="card shadow-sm h-100">

                                <div class="card-header fw-bold d-flex justify-content-between">

                                    <span>
                                        <i class="fas fa-ranking-star text-success me-2"></i>
                                        Vendor Performance Ranking
                                    </span>

                                    <span class="badge bg-primary">
                                        @(Model.VendorReport?.Count() ?? 0)
                                    </span>

                                </div>

                                <div class="card-body">

                                    <div class="table-responsive">

                                        <table id="tblVendorsCalculation"
                                               class="table table-hover table-bordered w-100" style="font-size:0.75rem;">

                                            <thead class="table-light" style="font-size:0.75rem;">

                                                <tr>
                                                    <th>#</th>
                                                    <th>Vendor Name</th>
                                                    <th class="text-end">Qty Received</th>
                                                    <th class="text-end">Qty Good</th>
                                                    <th class="text-end">Qty Repair</th>
                                                    <th class="text-end">Qty Reject</th>
                                                    <th class="text-end">Defect Rate</th>
                                                </tr>

                                            </thead>

                                            <tbody style="font-size:0.75rem;">

                                                @if (Model.VendorReport?.Any() == true)
                                                {
                                                    var i = 1;

                                                    foreach (var item in Model.VendorReport)
                                                    {
                                                        <tr>

                                                            <td>@i</td>

                                                            <td>
                                                                <strong>
                                                                    @item.VendorName
                                                                </strong>
                                                            </td>

                                                            <td class="text-end">
                                                                @item.QtyReceived.ToString("N0")
                                                            </td>

                                                            <td class="text-end">
                                                                @item.QtyGood.ToString("N0")
                                                            </td>

                                                            <td class="text-end">
                                                                @item.QtyRepair.ToString("N0")
                                                            </td>

                                                            <td class="text-end">
                                                                @item.QtyReject.ToString("N0")
                                                            </td>

                                                            <td class="text-end">

                                                                <span class="badge
                                                                    @(item.DefectRate >= 5
                                                                    ? "bg-danger"
                                                                    : item.DefectRate >= 2
                                                                        ? "bg-warning text-dark"
                                                                        : "bg-success")">

                                                                    @item.DefectRate.ToString("N2")%

                                                                </span>

                                                            </td>

                                                        </tr>

                                                        i++;
                                                    }
                                                }

                                            </tbody>

                                        </table>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>
				</div>
			</div>
		</div>
	</div>
</div>
@section Scripts
{
    <script>

        /* ============================================================
           UTILITIES
        ============================================================ */

        function getTableHeight() {
            return `${$(window).height() * 0.6}px`;
        }


        /* ============================================================
           DATATABLE
        ============================================================ */

        function createDataTable(selector, filename) {

            return $(selector).DataTable({
                pageLength: 25,
                paging: false,
                scrollX: true,
                scrollY: getTableHeight(),
                scrollCollapse: true,
                autoWidth: false,
                fixedHeader: false,
                responsive: false,

                dom: 'Bfrtip',

                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="fas fa-file-excel"></i> Export Excel',
                        className: 'btn btn-sm erp-btn',
                        title: null,
                        filename: filename,

                        exportOptions: {
                            columns: ':visible:not(.no-export)',
                            modifier: {
                                search: 'applied',
                                order: 'applied'
                            }
                        },

                        action: function (e, dt, button, config) {

                            const fileName = `${config.filename}.xlsx`;

                            const message =
                                `Export data to Excel?\n\n` +
                                `File:\n${fileName}\n\n` +
                                `The save location is controlled by your browser settings.`;

                            if (confirm(message)) {

                                $.fn.dataTable.ext.buttons.excelHtml5.action.call(
                                    this,
                                    e,
                                    dt,
                                    button,
                                    config
                                );
                            }
                        }
                    }
                ]
            });
        }


        /* ============================================================
           COLUMN FILTER
        ============================================================ */

        function addColumnFilter(table, tableId) {

            const $filter = $(`${tableId}_filter`);
            const $searchInput = $filter.find('input');

            const $columnFilter =
                $('<select class="columnFilter"></select>');


            // Remove default "Search:" text
            $filter
                .find('label')
                .contents()
                .filter((_, node) => node.nodeType === 3)
                .remove();


            // Search placeholder
            $searchInput.attr(
                'placeholder',
                'Type to filter (F3)'
            );


            // Create column options
            table.columns().every(function (index) {

                const title = $(this.header())
                    .text()
                    .trim();

                if (title) {
                    $columnFilter.append(
                        `<option value="${index}">${title}</option>`
                    );
                }
            });


            $searchInput.after($columnFilter);


            // Apply filter
            function filterData() {

                table.columns().search('');

                table
                    .column(Number($columnFilter.val()))
                    .search($searchInput.val())
                    .draw();
            }


            $searchInput.on('input', filterData);
            $columnFilter.on('change', filterData);


            // Move Excel button beside filter
            const $buttons =
                $(`${tableId}_wrapper .dt-buttons`);

            $columnFilter.after($buttons);
        }


        /* ============================================================
           VENDOR KPI CHART
        ============================================================ */

        async function loadVendorCharts() {

            try {

                const response = await fetch('?handler=VendorQA');

                if (!response.ok) {
                    throw new Error(
                        `VendorQA request failed: ${response.status}`
                    );
                }


                const data = await response.json();

                console.log('Vendor QA Data:', data);


                if (!Array.isArray(data)) {
                    throw new Error(
                        'VendorQA returned invalid data.'
                    );
                }


                /* ----------------------------------------------------
                   Filter vendors that have defects
                ---------------------------------------------------- */

                const vendors = data
                    .filter(v =>
                        Number(v.defectRate) > 0
                    )
                    .sort((a, b) =>
                        Number(b.defectRate) -
                        Number(a.defectRate)
                    );


                /* ----------------------------------------------------
                   Get chart canvas
                ---------------------------------------------------- */

                const canvas =
                    document.getElementById('chartMonth');

                if (!canvas) {
                    console.error(
                        'Vendor KPI chart canvas not found.'
                    );

                    return;
                }


                /* ----------------------------------------------------
                   Chart Configuration
                ---------------------------------------------------- */

                const config = {

                    type: 'bar',

                    data: {

                        labels: vendors.map(
                            v => v.vendorName
                        ),

                        datasets: [
                            {
                                label: 'Defect Rate',

                                data: vendors.map(
                                    v => Number(v.defectRate)
                                ),

                                backgroundColor: '#5B9BD5',
                                borderColor: '#5B9BD5',
                                borderWidth: 1,
                                barThickness: 20
                            }
                        ]
                    },

                    options: {

                        indexAxis: 'y',

                        responsive: true,

                        maintainAspectRatio: false,

                        plugins: {

                            legend: {
                                display: false
                            },

                            tooltip: {

                                callbacks: {

                                    label: function (context) {

                                        return `${Number(context.raw)
                                            .toFixed(2)}%`;
                                    }
                                }
                            }
                        },

                        scales: {

                            x: {

                                beginAtZero: true,

                                ticks: {

                                    callback: function (value) {
                                        return `${value}%`;
                                    }
                                }
                            },

                            y: {

                                ticks: {
                                    autoSkip: false,
                                    padding: 8
                                }
                            }
                        }
                    }
                };


                /* ----------------------------------------------------
                   Render Chart
                ---------------------------------------------------- */

                new Chart(
                    canvas,
                    config
                );

            }
            catch (error) {

                console.error(
                    'Error loading Vendor KPI:',
                    error
                );
            }
        }


        /* ============================================================
           PAGE LOAD
        ============================================================ */

        $(function () {

            const today = new Date()
                .toISOString()
                .split('T')[0];


            /* --------------------------------------------------------
               Vendor Master List
            -------------------------------------------------------- */

            const vendorTable =
                createDataTable(
                    '#tblVendorsCalculation',
                    `Vendor_Quality_Report_${today}`
                );

            addColumnFilter(
                vendorTable,
                '#tblVendorsCalculation'
            );


            /* --------------------------------------------------------
               Vendor KPI
            -------------------------------------------------------- */

            loadVendorCharts();


            /* --------------------------------------------------------
               Resize DataTables
            -------------------------------------------------------- */

            $(window).on('resize', function () {

                $.fn.dataTable
                    .tables({
                        visible: true,
                        api: true
                    })
                    .columns
                    .adjust();

            });

        });

    </script>
}
