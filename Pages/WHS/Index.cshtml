@page
@model PlanningTool.NavExtension.Pages.WHS.IndexModel
@{
	ViewBag.Title = "Warehouse Dashboard";

	var today = DateTime.Today;

	var upcoming = Model.ProcurementTagged
		.Where(x =>
			x._ptContainerETA.HasValue &&
			x._ptStatus == 1)
		.ToList();

	var totalPO = upcoming.Count();
	var totalContainer = upcoming.Select(x => x._ptContainerNo).Distinct().Count();
	var totalHBL = upcoming.Select(x => x._ptHBLNo).Distinct().Count();
	var totalVendor = upcoming.Select(x => x._ptVendorName).Distinct().Count();
}
<style>
	@@keyframes sail {
		0%, 100% {
			transform: translateX(0);
		}

		50% {
			transform: translateX(5px);
		}
	}
</style>
<div class="container-fluid">

	<!-- Page Header -->
	<div class="row mb-3">
		<div class="col-md-12">
			<h3 class="fw-bold d-inline me-4">
				WHS Dashboard
			</h3>

			<h6 class="mb-3 text-secondary">
				<i class="fas fa-ship me-2 text-primary"
				   style="display:inline-block; animation:sail 2s ease-in-out infinite;"></i>
				Upcoming Shipments (Next 14 Days)
			</h6>
			<hr />
		</div>
	</div>

	<!-- KPI CARDS -->
	<div class="row mb-4">

		<div class="col-md-3 mb-3">
			<div class="card qa-card h-100">
				<div class="card-body d-flex align-items-center">					
					<i class="bi bi-truck text-danger fs-1 me-3"></i>
					<div>
						<div class="kpi-value text-danger">@totalHBL</div>
						<div class="kpi-label">HBL</div>
					</div>
				</div>
			</div>
		</div>

		<div class="col-md-3 mb-3">
			<div class="card qa-card h-100">
				<div class="card-body d-flex align-items-center">					
					<i class="bi bi-boxes text-success fs-1 me-3"></i>
					<div>
						<div class="kpi-value text-success">@totalContainer</div>
						<div class="kpi-label">Containers</div>
					</div>
				</div>
			</div>
		</div>

		<div class="col-md-3 mb-3">
			<div class="card qa-card h-100">
				<div class="card-body d-flex align-items-center">
					<i class="bi bi-clipboard2-check text-primary fs-1 me-3"></i>					
					<div>
						<div class="kpi-value text-primary">@totalPO</div>
						<div class="kpi-label">PO Tagged</div>
					</div>
				</div>
			</div>
		</div>

		<div class="col-md-3 mb-3">
			<div class="card qa-card h-100">
				<div class="card-body d-flex align-items-center">					
					<i class="bi bi-person-badge text-warning fs-1 me-3"></i>
					<div>
						<div class="kpi-value text-warning">@totalVendor</div>
						<div class="kpi-label">Vendors</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	
	
	<table id="tblTagged" class="table table-hover w-100">
		<thead class="bg-white table-bordered">
			<tr style="font-size: 0.80em">
				<th>PO No</th>
				<th>Vendor</th>
				<th>Item Code</th>
				<th>Item Description</th>
				<th>PO Outstanding Qty</th>
				<th>Tagged Qty</th>
				<th>Balance For Tagging</th>
				<th>HBL No</th>
				<th>Container No</th>
				<th>Dedon ETA</th>
				<th>Country of Origin</th>
				<th>Remarks</th>
				<th class="text-center">Status</th>
			</tr>

		</thead>

		<tbody>

			@foreach (var item in upcoming)
			{
				var days = (item._ptContainerETA.Value.Date - today).Days;

				string badge;
				string text;

				if (days <= -7)
				{
					badge = "bg-danger";
					text = $"Delayed {Math.Abs(days)} Days";
				}
				else if (days < 0)
				{
					badge = "bg-warning";
					text = $"Due {Math.Abs(days)} Days Overdue";
				}
				else if (days >= 1 && days <= 14)
				{
					badge = "bg-success";
					text = $"Upcoming in {days} Days";
				}
				else if (days == 0)
				{
					badge = "bg-success";
					text = "Due Today";
				}
				else
				{
					badge = "bg-success";
					text = $"Upcoming in {days} Days";
				}

				<tr style="font-size: 0.8em">
					<td>@item._ptDocNo</td>
					<td>@item._ptVendorName</td>
					<td>@item._ptItemCode</td>
					<td>@item._ptItemDescription</td>
					<td>@item._ptOutstandingQty</td>
					<td>@item._ptPartialDelivered</td>
					<td>@item._ptBalanceQty</td>
					<td>@item._ptHBLNo</td>
					<td>@item._ptContainerNo</td>
					<td>
						@item._ptContainerETA.Value.ToString("yyyy-MM-dd")
					</td>
					<td>@item._ptCountryOfOrigin</td>
					<td>@item._ptRemarks</td>
					<td class="text-center">

						<span class="badge @badge">

							@text

						</span>

					</td>

				</tr>

			}

		</tbody>

	</table>	

</div>
@section Scripts {
	<script>

		/* ==============================
			Utilities
		============================== */

		function getTableHeight() {
			return `${$(window).height() * 0.6}px`;
		}

		/* ==============================
		DataTables
		============================== */

		function createDataTable(selector, filename) {

			return $(selector).DataTable({

				pageLength: 25,

				paging: false,

				scrollX: true,

				scrollY: getTableHeight(),

				scrollCollapse: true,

				autoWidth: false,

				fixedHeader: true,

				responsive: false,

				stateSave: false,

				destroy: true,

				// Sort Container ETA earliest first
				order: [[9, 'asc']],

				dom: 'Bfrtip',


				buttons: [

					{
						extend: 'excelHtml5',

						text: '<i class="fa fa-file-excel-o"></i> Export Excel',

						className: 'btn btn-sm erp-btn',


						title: null,

						filename: filename,


						exportOptions: {

							columns: ':visible:not(.no-export)',

							modifier: {
								search: 'applied',
								order: 'applied'
							}

						},


						action: function (e, dt, button, config) {

							const fileName = `${config.filename}.xlsx`;

							const message =
								`Export data to Excel?\n\n` +
								`File:\n${fileName}\n\n` +
								`The save location is controlled by your browser settings.`;


							if (confirm(message)) {

								$.fn.dataTable.ext.buttons.excelHtml5.action.call(
									this,
									e,
									dt,
									button,
									config
								);

							}

						}

					}

				]

			});
		}


		/* ==============================
		   Column Filter
		============================== */

		function addColumnFilter(table, tableId) {

			const $filter = $(`${tableId}_filter`);

			if (!$filter.length) return;


			const $searchInput = $filter.find('input');

			const $columnFilter = $('<select>', {
				class: 'columnFilter form-select form-select-sm'
			});


			// Remove default "Search:"
			$filter.find('label')
				.contents()
				.filter((_, node) => node.nodeType === 3)
				.remove();


			$searchInput.attr(
				'placeholder',
				'Type to filter (F3)'
			);


			table.columns().every(function (index) {

				const title = $(this.header())
					.text()
					.trim();


				if (title) {

					$columnFilter.append(
						$('<option>', {
							value: index,
							text: title
						})
					);

				}

			});


			$searchInput.after($columnFilter);


			function filterData() {

				table.columns().search('');


				table
					.column(Number($columnFilter.val()))
					.search($searchInput.val())
					.draw();

			}


			$searchInput.on('input', filterData);

			$columnFilter.on('change', filterData);

		}


		/* ==============================
		   Page Load
		============================== */

		$(function () {


			const today = new Date()
				.toISOString()
				.split('T')[0];


			const taggedTable = createDataTable(
				'#tblTagged',
				`Procurement_PO_Upcoming_${today}`
			);


			addColumnFilter(
				taggedTable,
				'#tblTagged'
			);


			if (typeof colorDuplicateHBL === 'function') {

				colorDuplicateHBL();

				taggedTable.on(
					'draw',
					colorDuplicateHBL
				);

			}


			$(window).on(
				'resize',
				function () {

					$.fn.dataTable
						.tables({
							visible: true,
							api: true
						})
						.columns
						.adjust();

				}
			);


		});


	</script>
}



